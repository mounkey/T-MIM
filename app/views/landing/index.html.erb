                  <i class="fas fa-comments me-2"></i> COTIZAR ESTE PLAN
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 4. Formulario de Solicitud de Contratación (Llegada del Botón ¡LO QUIERO!) -->
<section id="contratar" class="py-5" style="background-color: #f1f5f9;">
  <div class="container py-4">
    <div class="max-w-800 mx-auto">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-4 text-center">
          <span class="badge bg-primary px-3 py-1 mb-2">Comienza Hoy Mismo</span>
          <h3 class="fw-bold mb-1">Solicitud de Alta para tu Taller</h3>
          <p class="text-white-50 small mb-0">Completa los datos de tu taller. Te enviaremos tu enlace de activación en minutos.</p>
        </div>
        <div class="card-body p-4 p-md-5 bg-white">
          <%= form_with url: request_plan_path, method: :post, local: true, id: "formContratar" do |f| %>
            
            <!-- Selector de Plan (Viene preseleccionado al dar clic en el botón) -->
            <div class="mb-4 p-3 bg-light rounded-3 border">
              <label class="form-label fw-bold text-dark small text-uppercase mb-2">
                <i class="fas fa-tag text-primary me-1"></i> Plan Seleccionado *
              </label>
              <select name="plan_type" id="selectPlan" class="form-select form-select-lg fw-bold" required onchange="handlePlanChange(this.value)">
                <option value="inicial">Plan Inicial / Express — 0,5 UF / mes (Hasta 50 vehículos)</option>
                <option value="estandar">Plan Estándar — 1,5 UF / mes (Hasta 50 vehículos + Bodega)</option>
                <option value="pro" selected>Plan Pro — 2,5 UF / mes (Hasta 150 vehículos + Finanzas & OT)</option>
                <option value="full">Plan Full — 3,5 UF / mes (Hasta 300 vehículos + Pasarela Flow)</option>
                <option value="gran_taller">Plan Gran Taller — Cotización a medida (+300 vehículos)</option>
              </select>
            </div>

            <!-- Ciclo de Facturación -->
            <div class="mb-4">
              <label class="form-label fw-bold text-dark small text-uppercase">Ciclo de Cobro</label>
              <div class="row g-2">
                <div class="col-sm-6">
                  <div class="form-check p-3 border rounded bg-white h-100">
                    <input class="form-check-input" type="radio" name="billing_cycle" id="cycleMonthly" value="monthly" checked>
                    <label class="form-check-label fw-bold text-dark" for="cycleMonthly">
                      Suscripción Mensual
                      <small class="d-block text-muted fw-normal">Cobro mes a mes sin ataduras.</small>
                    </label>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="form-check p-3 border border-success rounded bg-success-subtle h-100">
                    <input class="form-check-input" type="radio" name="billing_cycle" id="cycleAnnual" value="annual">
                    <label class="form-check-label fw-bold text-success" for="cycleAnnual">
                      Anual (2 Meses GRATIS + 20% Cupo Extra)
                      <small class="d-block text-muted fw-normal">Pagas 10 meses y usas 12 meses.</small>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <!-- Datos del Taller -->
            <h6 class="fw-bold text-dark text-uppercase small border-bottom pb-2 mb-3">Datos del Taller y Contacto</h6>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Nombre del Taller / Fantasía *</label>
                <input type="text" name="taller_name" class="form-control" placeholder="Ej. Taller Mecánico San Jorge" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">RUT Empresa o Dueño *</label>
                <input type="text" name="rut" class="form-control" placeholder="Ej. 76.123.456-7" required>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Nombre del Contacto / Responsable *</label>
                <input type="text" name="contacto_nombre" class="form-control" placeholder="Ej. Juan Pérez" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Teléfono / WhatsApp *</label>
                <input type="tel" name="telefono" class="form-control" placeholder="Ej. +56 9 1234 5678" required>
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Correo Electrónico (Para envío de clave) *</label>
                <input type="email" name="email" class="form-control" placeholder="contacto@taller.cl" required>
              </div>
              <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">Ciudad / Comuna *</label>
                <input type="text" name="direccion" class="form-control" placeholder="Ej. Puerto Montt, Osorno, Santiago..." required>
              </div>
            </div>

            <!-- Método de Pago (Con la regla de negocio estricta acordada) -->
            <div class="mb-4 p-3 bg-light rounded-3 border" id="boxMetodoPago">
              <label class="form-label fw-bold text-dark small text-uppercase mb-2">
                <i class="fas fa-credit-card text-info me-1"></i> Método de Pago
              </label>
              
              <!-- Modo 1: Flow Automático (Obligatorio para Inicial, Estándar y Pro) -->
              <div id="flowOnlyMessage" class="d-block">
                <div class="p-3 border rounded bg-white">
                  <div class="d-flex align-items-center justify-content-between">
                    <div>
                      <strong class="text-dark d-block"><i class="fas fa-sync text-primary me-2"></i>Pago Automático con Tarjeta (Flow)</strong>
                      <small class="text-muted">Cobro automático mensual con Tarjeta de Crédito, Débito o Prepago. Seguro y sin enredos.</small>
                    </div>
                    <span class="badge bg-primary px-3 py-2">Requerido</span>
                  </div>
                </div>
                <input type="hidden" name="billing_mode" id="billingModeHidden" value="flow">
              </div>

              <!-- Modo 2: Opciones para Plan Full y Gran Taller -->
              <div id="flowOrTransferOption" class="d-none">
                <div class="form-check p-3 border rounded bg-white mb-2">
                  <input class="form-check-input" type="radio" name="billing_mode_choice" id="payFlow" value="flow" checked onchange="updateModeChoice('flow')">
                  <label class="form-check-label fw-bold text-dark" for="payFlow">
                    Suscripción Automática Online (Flow)
                    <small class="d-block text-muted fw-normal">Pago recurrente seguro con Webpay y tarjetas bancarias.</small>
                  </label>
                </div>
                <div class="form-check p-3 border rounded bg-white">
                  <input class="form-check-input" type="radio" name="billing_mode_choice" id="payTransfer" value="transfer" onchange="updateModeChoice('transfer')">
                  <label class="form-check-label fw-bold text-dark" for="payTransfer">
                    Transferencia Bancaria Directa a Mounkey SpA
                    <small class="d-block text-muted fw-normal">Facturación mensual contra comprobante de transferencia bancaria.</small>
                  </label>
                </div>
              </div>
            </div>

            <div class="d-grid mt-4">
              <button type="submit" class="btn btn-tmim-orange btn-lg py-3 fw-bold shadow">
                <i class="fas fa-paper-plane me-2"></i> ENVIAR SOLICITUD DE ALTA
              </button>
              <small class="text-muted text-center mt-2" style="font-size: 0.78rem;">
                Al enviar la solicitud aceptas los Términos de Servicio bajo Ley 19.799. Mounkey SpA &bull; Puerto Montt.
              </small>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script interactivo para el acordeón y la selección automática del plan -->
<script>
  function selectPlan(planKey, price) {
    var select = document.getElementById('selectPlan');
    if (select) {
      select.value = planKey;
      handlePlanChange(planKey);
    }
  }

  function setBillingCycle(cycle) {
    if (cycle === 'annual') {
      var radio = document.getElementById('cycleAnnual');
      if (radio) radio.checked = true;
    }
  }

  function handlePlanChange(planKey) {
    var flowOnly = document.getElementById('flowOnlyMessage');
    var flowOrTransfer = document.getElementById('flowOrTransferOption');
    var hiddenMode = document.getElementById('billingModeHidden');

    if (planKey === 'full' || planKey === 'gran_taller') {
      // Habilitar selección entre Flow y Transferencia
      if (flowOnly) flowOnly.classList.replace('d-block', 'd-none');
      if (flowOrTransfer) flowOrTransfer.classList.replace('d-none', 'd-block');
      var checkedChoice = document.querySelector('input[name="billing_mode_choice"]:checked');
      if (hiddenMode && checkedChoice) {
        hiddenMode.value = checkedChoice.value;
      }
    } else {
      // Forzar solo Flow para Inicial, Estándar y Pro
      if (flowOnly) flowOnly.classList.replace('d-none', 'd-block');
      if (flowOrTransfer) flowOrTransfer.classList.replace('d-block', 'd-none');
      if (hiddenMode) hiddenMode.value = 'flow';
    }
  }

  function updateModeChoice(mode) {
    var hiddenMode = document.getElementById('billingModeHidden');
    if (hiddenMode) hiddenMode.value = mode;
  }

  // Inicializar al cargar
  document.addEventListener("DOMContentLoaded", function() {
    var select = document.getElementById('selectPlan');
    if (select) handlePlanChange(select.value);
  });
</script>
