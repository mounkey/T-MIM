<% content_for :page_title, "Regiones" %>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to "Nuevo", new_region_path, class: "btn btn-primary rounded-pill px-4", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" %>
    </div>

    <div id="regions_grid" class="table-responsive">
      <table class="table table-hover align-middle" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="text-dark">Nombre</th>
            <th class="text-dark">Código</th>
            <th class="text-end text-dark">Accion</th>
          </tr>
        </thead>
        <tbody>
          <% @regions.each do |region| %>
            <tr>
              <td class="text-dark"><%= region.name %></td>
              <td class="text-dark"><%= region.code %></td>
              <td class="text-end">
                <%= link_to edit_region_path(region), class: "action-icon edit", title: "Editar", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
                  <i class="fas fa-pencil-alt"></i>
                <% end %>
                <%= button_to region_path(region), method: :delete, class: "btn btn-link action-icon delete p-0 border-0", form: { style: "display:inline-block;" }, data: { turbo_confirm: "Advertencia: si elimina la región se borrarán las ciudades relacionadas. ¿Está seguro?" }, title: "Eliminar" do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @regions %>
    </div>
  </div>
</div>
