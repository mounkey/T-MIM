<div class="container py-5 mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-6">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white p-4 text-center">
          <i class="fas fa-shield-alt fa-3x text-primary mb-2"></i>
          <h3 class="fw-bold mb-1">Defina su Contraseña Definitiva</h3>
          <p class="text-white-50 small mb-0">Cree la contraseña segura y personal para acceder a su taller en T-MIM.</p>
        </div>
        <div class="card-body p-4 p-md-5 bg-white">
          <div class="alert alert-light border small text-muted mb-4">
            <i class="fas fa-info-circle text-primary me-1"></i> Por seguridad, su contraseña debe tener al menos 8 caracteres, números y letras.
          </div>

          <%= form_with url: set_final_password_account_path(token: @account.invitation_token), method: :post, local: true do |f| %>
            <div class="mb-3">
              <label class="form-label fw-bold text-dark small">Nueva Contraseña Definitiva *</label>
              <input type="password" name="password" class="form-control form-control-lg" required minlength="8" placeholder="••••••••">
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold text-dark small">Confirmar Contraseña *</label>
              <input type="password" name="password_confirmation" class="form-control form-control-lg" required minlength="8" placeholder="••••••••">
            </div>

            <button type="submit" class="btn btn-tmim-orange btn-lg w-100 py-3 shadow">
              <i class="fas fa-check-circle me-2"></i> Guardar y Entrar a T-MIM
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
