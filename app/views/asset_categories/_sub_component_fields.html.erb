<div class="nested-form-wrapper mb-2 border-start border-3 border-secondary ps-3" data-new-record="<%= f.object.new_record? %>">
  <div class="d-flex align-items-center mb-1">
    <%= f.hidden_field :_destroy %>
    <div class="flex-grow-1">
      <%= f.input :name, label: false, placeholder: "Nombre del Sub-componente (ej: Aceite)", wrapper_html: { class: "mb-0" } %>
    </div>
    <div class="ms-2">
      <button type="button" class="btn btn-outline-danger btn-sm" data-action="nested-form#remove">
        <i class="fas fa-trash"></i>
      </button>
    </div>
  </div>
</div>
