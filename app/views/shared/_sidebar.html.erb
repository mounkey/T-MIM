        </div>

        <!-- Logo -->
        <div class="sidebar-logo">
          <%= image_tag "logo.png", alt: "T-MIM Logo", style: "max-width: 100%; height: auto; max-height: 120px;" %>
        </div>

        <!-- Navigation -->
        <div class="nav-menu">
          <%= link_to authenticated_root_path, class: "nav-link #{'active' if current_page?(authenticated_root_path)}" do %>
