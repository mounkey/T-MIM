                 <%= link_to "Regiones", regions_path, class: "nav-link small py-1 ps-3 #{'active' if current_page?(regions_path)}" %>
                 <%= link_to "Ciudades", cities_path, class: "nav-link small py-1 ps-3 #{'active' if current_page?(cities_path)}" %>

