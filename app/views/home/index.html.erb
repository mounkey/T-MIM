<% content_for :page_title, "Dashboard" %>

<div class="container-fluid pb-5">
  <!-- Welcome Header & Subscription Plan Status -->
  <% account = current_user.account %>
  <% if account %>
    <% pct = account.capacity_percentage %>
    <% alert_level = account.capacity_alert_level %>
    
    <% if alert_level == :limit_reached %>
      <div class="alert alert-danger shadow-lg border-2 border-danger d-flex align-items-center justify-content-between p-3 mb-4 animate__animated animate__shakeX">
        <div class="d-flex align-items-center">
          <i class="fas fa-ban fa-2x me-3 text-danger"></i>
          <div>
            <h5 class="fw-bold mb-1 text-danger">LÍMITE MENSUAL DE VEHÍCULOS ALCANZADO (100%)</h5>
            <p class="mb-0 small text-dark">Ha alcanzado el tope de <strong><%= account.assets.count %> / <%= account.effective_assets_limit %> vehículos</strong> de su <strong>Plan <%= account.plan_name %></strong>. El registro de nuevos vehículos está temporalmente bloqueado.</p>
          </div>
        </div>
        <div class="text-end">
          <a href="mailto:contacto@t-mim.cl?subject=Ampliacion%20Cupo%20Taller%20<%= account.name %>" class="btn btn-danger fw-bold shadow-sm">
            <i class="fas fa-arrow-circle-up me-1"></i> Ampliar Plan o Paquete
          </a>
        </div>
      </div>
    <% elsif alert_level == :critical_warning %>
      <div class="alert alert-warning shadow border-2 border-warning d-flex align-items-center justify-content-between p-3 mb-4">
        <div class="d-flex align-items-center">
          <i class="fas fa-exclamation-triangle fa-2x me-3 text-warning"></i>
          <div>
            <h5 class="fw-bold mb-1 text-dark">AVISO DE CAPACIDAD: <%= pct %>% CONSUMIDO</h5>
            <p class="mb-0 small text-dark">Lleva registrados <strong><%= account.assets.count %> de <%= account.effective_assets_limit %> vehículos</strong> este mes en su <strong>Plan <%= account.plan_name %></strong>. Está al 95%+ de su cuota contratada.</p>
          </div>
        </div>
        <div class="text-end">
          <a href="mailto:contacto@t-mim.cl?subject=Consulta%20Upgrade%20<%= account.name %>" class="btn btn-warning text-dark fw-bold shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Cotizar Paquete Extra
          </a>
        </div>
      </div>
    <% end %>

    <!-- Plan info bar -->
    <div class="card bg-dark text-white border-secondary mb-4 shadow-sm">
      <div class="card-body p-3">
        <div class="row align-items-center">
          <div class="col-md-4 mb-2 mb-md-0">
            <div class="d-flex align-items-center">
              <div class="rounded-circle p-2 bg-primary bg-opacity-25 text-primary me-3">
                <i class="fas fa-certificate fa-lg"></i>
              </div>
              <div>
                <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 10px; letter-spacing: 0.5px;">Plan Contratado</small>
                <div class="d-flex align-items-center gap-2">
                  <span class="fs-5 fw-bold text-white">Plan <%= account.plan_name %></span>
                  <span class="badge bg-primary text-uppercase" style="font-size: 11px;"><%= account.monthly_price_uf %> UF / mes</span>
                  <% if account.annual_cycle? %>
                    <span class="badge bg-success" style="font-size: 10px;"><i class="fas fa-gift me-1"></i>Anual +20% Cupo</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-5 mb-2 mb-md-0">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <small class="text-muted text-uppercase fw-bold" style="font-size: 10px;">Consumo de Flota / Mes</small>
              <small class="fw-bold <%= pct >= 100 ? 'text-danger' : (pct >= 90 ? 'text-warning' : 'text-info') %>">
                <%= account.assets.count %> / <%= account.effective_assets_limit %> vehículos (<%= pct %>%)
              </small>
            </div>
            <div class="progress" style="height: 10px; background-color: rgba(255,255,255,0.1);">
              <div class="progress-bar <%= pct >= 100 ? 'bg-danger' : (pct >= 90 ? 'bg-warning text-dark' : 'bg-primary') %>" 
                   role="progressbar" 
                   style="width: <%= [pct, 100].min %>%;" 
                   aria-valuenow="<%= pct %>" 
                   aria-valuemin="0" 
                   aria-valuemax="100">
              </div>
            </div>
          </div>

          <div class="col-md-3 text-md-end">
            <small class="text-muted d-block" style="font-size: 11px;">
              Modalidad: <strong><%= account.flow_debit? ? 'Débito Automático Flow' : 'Transferencia Bancaria' %></strong>
            </small>
            <small class="text-muted" style="font-size: 11px;">
              Ciclo: <strong><%= account.annual_cycle? ? 'Anual (Prepagado)' : 'Mensual recurrente' %></strong>
            </small>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Welcome Header -->
  <div class="row mb-4">
    <div class="col-12 text-white">
      <h3>Bienvenido, <%= current_user.name %></h3>
      <p class="lead mb-0">Torre de Control de Mantenimiento</p>
    </div>
  </div>

  <!-- Row 1: KPIs (The Executive Semaphore) -->
  <div class="row g-3 mb-4">
    <!-- Critical -->
    <div class="col-12 col-sm-6 col-md-3">
      <div class="card bg-danger text-white p-3 h-100 shadow border-0 position-relative overflow-hidden">
         <div class="position-relative z-1">
           <h6 class="text-uppercase fw-bold opacity-75">Críticos</h6>
           <p class="display-4 fw-bold mb-0"><%= @critical_count %></p>
           <small>Requieren atención inmediata</small>
         </div>
         <i class="fas fa-exclamation-triangle fa-5x position-absolute end-0 bottom-0 m-n3 opacity-25" style="transform: rotate(-15deg);"></i>
      </div>
    </div>

    <!-- Warning -->
    <div class="col-12 col-sm-6 col-md-3">
      <div class="card bg-warning text-dark p-3 h-100 shadow border-0 position-relative overflow-hidden">
         <div class="position-relative z-1">
           <h6 class="text-uppercase fw-bold opacity-75">Alertas</h6>
           <p class="display-4 fw-bold mb-0"><%= @warning_count %></p>
           <small>Mantenimiento próximo</small>
         </div>
         <i class="fas fa-clock fa-5x position-absolute end-0 bottom-0 m-n3 opacity-25" style="transform: rotate(-15deg);"></i>
      </div>
    </div>

    <!-- Operational -->
    <div class="col-12 col-sm-6 col-md-3">
      <div class="card bg-success text-white p-3 h-100 shadow border-0 position-relative overflow-hidden">
         <div class="position-relative z-1">
           <h6 class="text-uppercase fw-bold opacity-75">Operativas</h6>
           <p class="display-4 fw-bold mb-0"><%= @operational_count %></p>
           <small>Sin alertas activas</small>
         </div>
         <i class="fas fa-check-circle fa-5x position-absolute end-0 bottom-0 m-n3 opacity-25" style="transform: rotate(-15deg);"></i>
      </div>
    </div>

    <!-- Availability -->
    <div class="col-12 col-sm-6 col-md-3">
      <div class="card bg-info text-white p-3 h-100 shadow border-0 position-relative overflow-hidden" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0);">
         <div class="position-relative z-1">
           <h6 class="text-uppercase fw-bold opacity-75">Disponibilidad</h6>
           <p class="display-4 fw-bold mb-0"><%= @availability %>%</p>
           <small>De la flota total (<%= @total_assets %>)</small>
         </div>
         <i class="fas fa-chart-line fa-5x position-absolute end-0 bottom-0 m-n3 opacity-25" style="transform: rotate(-15deg);"></i>
      </div>
    </div>
  </div>

  <!-- Row 2: Priority Table & Health Chart -->
  <div class="row g-3 mb-5">
    <!-- Top Priority Table -->
    <div class="col-12 col-lg-8">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-list-ol text-danger me-2"></i>Top 5 Prioridad</h5>
          <%= link_to "Ver Todo", maintenance_path(filter: 'critical'), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="card-body p-0 table-responsive">
          <table class="table table-hover align-middle mb-0" style="color: #333 !important;">
            <thead class="table-light">
              <tr>
                <th class="text-dark ps-3">Vehículo</th>
                <th class="text-dark">Categoría</th>
                <th class="text-dark">Estado General</th>
                <th class="text-end text-dark pe-3">Acción</th>
              </tr>
            </thead>
            <tbody>
              <% if @priority_assets.any? %>
                <% @priority_assets.each do |asset| %>
                  <%
                    # Determine styling based on worst plan status (logic reused from controller for simplicity here)
                    worst_state = asset.maintenance_states.max_by { |s| MaintenanceState.current_statuses[s.current_status] }
                    status_sym = worst_state&.current_status&.to_sym || :white

                    status_badge = case status_sym
                                   when :red then 'badge bg-danger'
                                   when :orange then 'badge bg-warning text-dark'
                                   else 'badge bg-success'
                                   end
                    status_text = case status_sym
                                  when :red then 'Crítico'
                                  when :orange then 'Alerta'
                                  else 'OK'
                                  end
                  %>
                  <tr>
                    <td class="ps-3 fw-bold">
                      <%= asset.name %>
                      <div class="small text-muted fw-normal"><%= asset.serial_number %></div>
                    </td>
                    <td><%= asset.asset_category&.name %></td>
                    <td><span class="<%= status_badge %>"><%= status_text %></span></td>
                    <td class="text-end pe-3">
                      <%= link_to new_logbook_path(asset_id: asset.id), class: "btn btn-sm btn-primary" do %>
                        <i class="fas fa-edit"></i> Bitácora
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="text-center py-5 text-muted">
                    <i class="fas fa-thumbs-up fa-3x mb-3 text-success opacity-50"></i>
                    <p class="h6">¡Excelente! No hay alertas pendientes.</p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Health Chart (Donut CSS) -->
    <div class="col-12 col-lg-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-header bg-white py-3">
          <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-heartbeat text-info me-2"></i>Salud de Flota</h5>
        </div>
        <div class="card-body d-flex flex-column justify-content-center align-items-center">
          <!-- CSS Donut Chart -->
          <%
             # Calculate degrees for CSS conic-gradient
             total = @total_assets.to_f
             return if total == 0

             p_red = (@critical_count / total) * 100
             p_orange = (@warning_count / total) * 100
             p_green = (@operational_count / total) * 100

             deg_red = (p_red * 3.6).round
             deg_orange = (p_orange * 3.6).round
             deg_green = (p_green * 3.6).round

             # Cumulative start points
             start_red = 0
             end_red = deg_red
             start_orange = end_red
             end_orange = end_red + deg_orange
             start_green = end_orange
             end_green = 360 # Fill rest
          %>

          <div class="position-relative d-flex justify-content-center align-items-center" style="width: 200px; height: 200px;">
            <div class="rounded-circle" style="
              width: 100%;
              height: 100%;
              background: conic-gradient(
                #dc3545 <%= start_red %>deg <%= end_red %>deg,
                #ffc107 <%= start_orange %>deg <%= end_orange %>deg,
                #198754 <%= start_green %>deg <%= end_green %>deg
              );
            "></div>
            <!-- Inner white circle for donut effect -->
            <div class="bg-white rounded-circle position-absolute" style="width: 70%; height: 70%; display: flex; align-items: center; justify-content: center; flex-direction: column;">
               <span class="h1 fw-bold mb-0"><%= @total_assets %></span>
               <small class="text-muted text-uppercase" style="font-size: 0.7em;">Total</small>
            </div>
          </div>

          <!-- Legend -->
          <div class="mt-4 w-100 px-4">
            <div class="d-flex justify-content-between mb-2">
              <span><i class="fas fa-circle text-danger me-2"></i>Crítico</span>
              <span class="fw-bold"><%= @critical_count %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span><i class="fas fa-circle text-warning me-2"></i>Alerta</span>
              <span class="fw-bold"><%= @warning_count %></span>
            </div>
            <div class="d-flex justify-content-between">
              <span><i class="fas fa-circle text-success me-2"></i>Operativo</span>
              <span class="fw-bold"><%= @operational_count %></span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Row 3: Categories (Shortcuts) - Pushed to bottom -->
  <div class="row">
    <div class="col-12">
      <h5 class="text-white mb-3">Acceso Rápido</h5>
    </div>
    <% @dashboard_categories.each do |category| %>
      <div class="col-6 col-md-3 col-lg-2 mb-3">
        <%= link_to asset_category_path(category), class: "text-decoration-none" do %>
          <div class="card bg-white text-dark p-2 text-center h-100 shadow-sm border-0 hover-lift">
             <div class="card-body">
               <i class="fas <%= category.icon %> fa-2x text-primary mb-2"></i>
               <h6 class="card-title mb-0 small text-truncate"><%= category.name %></h6>
             </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .hover-lift { transition: transform 0.2s; }
  .hover-lift:hover { transform: translateY(-3px); }
</style>
