<% content_for :page_title, "Wiki & Base de Conocimiento" %>

<div class="container-fluid pb-5">
  <!-- Header Bar -->
  <div class="row mb-4 align-items-center">
    <div class="col-md-7 text-white">
      <h3 class="mb-1"><i class="fas fa-book-reader me-2"></i>Wiki & Manuales de Operación</h3>
      <p class="lead mb-0 text-white opacity-75">Centro de guías oficiales de T-MIM y procedimientos técnicos de su taller</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
      <%= link_to new_wiki_path, class: "btn btn-light text-primary rounded-pill px-4 fw-bold shadow-sm", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
        <i class="fas fa-plus me-1"></i> Nuevo Procedimiento del Taller
      <% end %>
    </div>
  </div>

  <!-- Search & Navigation Tabs -->
  <div class="card bg-white border-0 shadow-sm rounded-4 mb-4 p-3">
    <div class="row g-3 align-items-center justify-content-between">
      <div class="col-md-6">
        <ul class="nav nav-pills" id="wikiTabs">
          <li class="nav-item">
            <%= link_to wiki_index_path(tab: "manual"), class: "nav-link rounded-pill px-4 #{'active' if @active_tab == 'manual'}" do %>
              <i class="fas fa-book me-2"></i> Guía Oficial T-MIM (<%= @global_articles.count %>)
            <% end %>
          </li>
          <li class="nav-item ms-2">
            <%= link_to wiki_index_path(tab: "company"), class: "nav-link rounded-pill px-4 #{'active' if @active_tab == 'company'}" do %>
              <i class="fas fa-tools me-2"></i> Fichas del Taller <%= current_user.account.name %> (<%= @company_articles.count %>)
            <% end %>
          </li>
        </ul>
      </div>

      <div class="col-md-5">
        <%= form_with url: wiki_index_path, method: :get, local: true, class: "d-flex gap-2" do |f| %>
          <input type="hidden" name="tab" value="<%= @active_tab %>">
          <div class="input-group">
            <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" name="q" value="<%= @query %>" placeholder="Buscar procedimiento, aceite, torque, patente, repuesto..." class="form-control bg-light border-0">
            <% if @query.present? %>
              <%= link_to wiki_index_path(tab: @active_tab), class: "btn btn-light border-0 text-muted" do %>
                <i class="fas fa-times"></i>
              <% end %>
            <% end %>
          </div>
          <button type="submit" class="btn btn-primary rounded-pill px-3">Buscar</button>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Main Content Layout (Sidebar Index + Reader Panel) -->
  <div class="row g-4">
    <!-- Left Navigation Index -->
    <div class="col-lg-4 col-md-5">
      <div class="card bg-white border-0 shadow-sm rounded-4 p-3 h-100">
        <h6 class="fw-bold text-dark px-2 mb-3 text-uppercase small">
          <i class="fas fa-list-ul me-2 text-primary"></i>
          <%= @active_tab == 'manual' ? 'Índice de Guías Oficiales' : 'Procedimientos Internos del Taller' %>
        </h6>

        <% current_list = (@active_tab == 'manual' ? @global_articles : @company_articles) %>

        <% if current_list.any? %>
          <% current_list.group_by(&:category).each do |category, articles| %>
            <div class="mb-3">
              <span class="badge bg-light text-secondary border px-2 py-1 mb-2 fw-semibold" style="font-size: 0.75rem;">
                <%= category %>
              </span>
              <div class="list-group list-group-flush">
                <% articles.each do |article| %>
                  <% is_selected = (@selected_article&.id == article.id) %>
                  <%= link_to wiki_index_path(id: article.id, tab: @active_tab, q: @query), class: "list-group-item list-group-item-action rounded-3 mb-1 border-0 d-flex align-items-center justify-content-between p-2 #{is_selected ? 'bg-primary text-white fw-bold shadow-sm' : 'text-dark'}" do %>
                    <div class="d-flex align-items-center text-truncate">
                      <i class="fas <%= article.icon.presence || 'fa-file-alt' %> me-2 <%= is_selected ? 'text-white' : 'text-primary' %>"></i>
                      <span class="text-truncate" style="font-size: 0.9rem;"><%= article.title %></span>
                    </div>
                    <% if is_selected %>
                      <i class="fas fa-chevron-right ms-2 text-white small"></i>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="text-center py-5 text-muted">
            <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
            <p class="small mb-0">No se encontraron artículos con el filtro actual.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Right Content Reader Panel -->
    <div class="col-lg-8 col-md-7">
      <div class="card bg-white border-0 shadow-sm rounded-4 p-4 p-md-5 h-100">
        <% if @selected_article %>
          <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-3 mb-4 gap-2">
            <div>
              <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge <%= @selected_article.is_global? ? 'bg-primary' : 'bg-success' %> text-white">
                  <%= @selected_article.is_global? ? 'Guía Oficial T-MIM' : 'Procedimiento Taller' %>
                </span>
                <span class="badge bg-light text-dark border">
                  <%= @selected_article.category %>
                </span>
              </div>
              <h3 class="fw-bold text-dark mb-0 mt-2">
                <i class="fas <%= @selected_article.icon.presence || 'fa-book-open' %> me-2 text-primary"></i>
                <%= @selected_article.title %>
              </h3>
            </div>

            <!-- Actions (Edit/Delete only for company articles) -->
            <% unless @selected_article.is_global? %>
              <div class="d-flex gap-2">
                <%= link_to edit_wiki_path(@selected_article), class: "btn btn-sm btn-outline-primary rounded-pill px-3", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
                  <i class="fas fa-edit me-1"></i> Editar
                <% end %>
                <%= link_to wiki_path(@selected_article), data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar este procedimiento técnico del taller?" }, class: "btn btn-sm btn-outline-danger rounded-pill px-3" do %>
                  <i class="fas fa-trash me-1"></i> Eliminar
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Reader Article Body -->
          <div class="wiki-content text-dark" style="font-size: 1.02rem; line-height: 1.8;">
            <%= simple_format(@selected_article.content) %>
          </div>

        <% else %>
          <div class="text-center py-5 text-muted my-auto">
            <i class="fas fa-book-reader fa-4x mb-3 text-secondary opacity-50"></i>
            <h4 class="text-dark fw-bold">Seleccione un manual o procedimiento</h4>
            <p class="text-muted">Navegue por el índice lateral para leer las guías operativas o cree sus propios procedimientos de taller.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
