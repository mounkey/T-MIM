<% content_for :page_title, "Proveedores" %>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="d-flex justify-content-end mb-3">
      <%= link_to "Nuevo", new_provider_path, class: "btn btn-primary rounded-pill px-4" %>
    </div>

    <div id="providers_grid" class="table-responsive">
      <table class="table table-hover align-middle" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="text-dark">Nombre</th>
            <th class="text-dark">RUT</th>
            <th class="text-dark">Ciudad</th>
            <th class="text-dark">Calificación</th>
            <th class="text-dark">Etiquetas</th>
            <th class="text-end text-dark">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% @providers.each do |provider| %>
            <%= render provider %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @providers %>
    </div>
  </div>
</div>
