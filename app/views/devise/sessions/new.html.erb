<h2 class="mb-4">Login</h2>

<%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), defaults: { label: false }) do |f| %>
  <div class="form-inputs mb-3">
    <%= f.input :email,
                required: false,
                autofocus: true,
                input_html: { autocomplete: "email", placeholder: "Mail" },
                placeholder: "Mail" %>
  </div>
  <div class="form-inputs mb-4">
    <%= f.input :password,
                required: false,
                input_html: { autocomplete: "current-password", placeholder: "Contraseña" },
                placeholder: "Contraseña" %>
    <div class="text-end mt-1">
        <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
          <%= link_to "Contraseña", new_password_path(resource_name), style: "font-size: 0.9rem; text-decoration: none;" %>
        <% end %>
    </div>
  </div>

  <div class="form-actions d-flex justify-content-between align-items-center">
    <div class="text-white">
      Respuesta
    </div>
    <div>
      <%= f.button :submit, "Logear", class: "btn-login px-5" %>
    </div>
  </div>
<% end %>
