<% content_for :page_title, "Clientes" %>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="card-title mb-0 fw-bold text-dark">Listado de Clientes</h5>
      <%= link_to "Nuevo Cliente", new_client_path, class: "btn btn-primary rounded-pill px-4" %>
    </div>

    <div id="clients_grid" class="table-responsive">
      <table class="table table-hover align-middle" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="text-dark">Nombre / Razón Social</th>
            <th class="text-dark">RUT / DNI</th>
            <th class="text-dark">Teléfono</th>
            <th class="text-dark">Email</th>
            <th class="text-dark">Vehículos</th>
            <th class="text-end text-dark">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @clients.any? %>
            <% @clients.each do |client| %>
              <tr>
                <td class="fw-bold"><%= link_to client.name, client_path(client), class: "text-decoration-none text-dark" %></td>
                <td><%= client.rut.presence || "-" %></td>
                <td><%= client.phone.presence || "-" %></td>
                <td><%= client.email.presence || "-" %></td>
                <td><span class="badge bg-secondary rounded-pill"><%= client.assets.count %></span></td>
                <td class="text-end">
                  <%= link_to edit_client_path(client), class: "btn btn-sm btn-outline-primary me-1" do %>
                    <i class="fas fa-edit"></i>
                  <% end %>
                  <%= link_to client_path(client), data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar este cliente?" }, class: "btn btn-sm btn-outline-danger" do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No hay clientes registrados aún.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @clients %>
    </div>
  </div>
</div>
