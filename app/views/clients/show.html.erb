<% content_for :page_title, "Ficha del Cliente" %>

<div class="container-fluid pb-4">
  <div class="row g-4">
    <!-- Client Info Card -->
    <div class="col-12 col-lg-4">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><%= @client.name %></h5>
            <%= link_to edit_client_path(@client), class: "btn btn-sm btn-outline-primary" do %>
              <i class="fas fa-edit"></i>
            <% end %>
          </div>
          <hr>
          <div class="mb-2">
            <small class="text-muted d-block">RUT / DNI</small>
            <span class="fw-semibold"><%= @client.rut.presence || "No registrado" %></span>
          </div>
          <div class="mb-2">
            <small class="text-muted d-block">Teléfono / WhatsApp</small>
            <span class="fw-semibold"><%= @client.phone.presence || "No registrado" %></span>
          </div>
          <div class="mb-2">
            <small class="text-muted d-block">Correo Electrónico</small>
            <span class="fw-semibold"><%= @client.email.presence || "No registrado" %></span>
          </div>
          <div class="mb-2">
            <small class="text-muted d-block">Dirección</small>
            <span class="fw-semibold"><%= @client.address.presence || "No registrada" %></span>
          </div>
          <% if @client.notes.present? %>
            <div class="mt-3 p-2 bg-light rounded">
              <small class="text-muted d-block">Notas:</small>
              <small><%= @client.notes %></small>
            </div>
          <% end %>

          <div class="mt-4">
            <%= link_to "Volver al listado", clients_path, class: "btn btn-outline-secondary btn-sm w-100 rounded-pill" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Vehicles List Card -->
    <div class="col-12 col-lg-8">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-car text-primary me-2"></i>Vehículos Asociados</h5>
            <%= link_to "Nuevo Vehículo", new_asset_path(client_id: @client.id), class: "btn btn-sm btn-primary rounded-pill px-3" %>
          </div>

          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th class="text-dark">Patente</th>
                  <th class="text-dark">Marca / Modelo</th>
                  <th class="text-dark">Año</th>
                  <th class="text-dark">Estado</th>
                  <th class="text-end text-dark">Acción</th>
                </tr>
              </thead>
              <tbody>
                <% if @vehicles.any? %>
                  <% @vehicles.each do |vehicle| %>
                    <tr>
                      <td class="fw-bold"><%= vehicle.plate.presence || vehicle.name %></td>
                      <td><%= "#{vehicle.make} #{vehicle.model}".strip.presence || "-" %></td>
                      <td><%= vehicle.year.presence || "-" %></td>
                      <td>
                        <span class="badge <%= vehicle.operativa? ? 'bg-success' : 'bg-warning text-dark' %>">
                          <%= vehicle.status_label %>
                        </span>
                      </td>
                      <td class="text-end">
                        <%= link_to new_logbook_path(asset_id: vehicle.id), class: "btn btn-sm btn-outline-primary" do %>
                          <i class="fas fa-clipboard-list"></i> Bitácora
                        <% end %>
                        <%= link_to edit_asset_path(vehicle), class: "btn btn-sm btn-outline-secondary ms-1" do %>
                          <i class="fas fa-edit"></i>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Este cliente no tiene vehículos asociados todavía.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
