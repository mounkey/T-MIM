<%= turbo_stream.update "flash" do %>
  <%= render partial: "shared/flash" %>
<% end %>

<%= turbo_stream.update "tags_grid" do %>
  <table class="table table-hover align-middle">
    <thead class="table-light">
      <tr>
        <th>Nombre</th>
        <th>Color</th>
        <th class="text-end">Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @tags.each do |tag| %>
        <tr>
          <td><%= tag.name %></td>
          <td>
            <span class="badge rounded-pill" style="background-color: <%= tag.color %>; color: white; text-shadow: 0 1px 1px rgba(0,0,0,0.5);">
              <%= tag.color %>
            </span>
          </td>
          <td class="text-end">
            <%= link_to edit_tag_path(tag), class: "text-primary me-2", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
              <i class="fas fa-pencil-alt"></i>
            <% end %>
            <%= button_to tag_path(tag), method: :delete, class: "btn btn-link text-danger p-0 border-0", form: { style: "display:inline-block;" }, data: { turbo_confirm: "¿Estás seguro?" } do %>
              <i class="fas fa-trash"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= turbo_stream.append "modal_body" do %>
  <div data-controller="modal-close"></div>
<% end %>
