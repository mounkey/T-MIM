<% content_for :page_title, "Categorías de Bodega (Repuestos e Insumos)" %>

<div class="card shadow-sm border-0 bg-white">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h5 class="fw-bold text-dark mb-1"><i class="fas fa-tags text-primary me-2"></i>Familias y Categorías de Repuestos</h5>
        <p class="text-muted small mb-0">Define las categorías personalizadas para clasificar repuestos, lubricantes e insumos en el taller.</p>
      </div>
      <%= link_to new_warehouse_category_path, class: "btn btn-primary rounded-pill px-4 shadow-sm", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
        <i class="fas fa-plus me-1"></i> Nueva Categoría
      <% end %>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="ps-3 text-dark">Nombre de Categoría</th>
            <th class="text-dark">Descripción</th>
            <th class="text-center text-dark">Ítems Asociados</th>
            <th class="text-end pe-3 text-dark">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @categories.any? %>
            <% @categories.each do |cat| %>
              <% items_count = WarehouseItem.where(category: cat.name).count %>
              <tr>
                <td class="ps-3 fw-bold text-dark">
                  <span class="badge bg-light text-dark border me-2"><i class="fas fa-box text-primary"></i></span>
                  <%= cat.name %>
                </td>
                <td class="text-muted"><%= cat.description.presence || "-" %></td>
                <td class="text-center">
                  <span class="badge bg-secondary px-2 py-1"><%= items_count %> productos</span>
                </td>
                <td class="text-end pe-3">
                  <%= link_to edit_warehouse_category_path(cat), class: "btn btn-sm btn-outline-primary me-1", title: "Editar", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
                    <i class="fas fa-pencil-alt"></i>
                  <% end %>
                  <%= button_to warehouse_category_path(cat), method: :delete, class: "btn btn-sm btn-outline-danger", form: { style: "display:inline-block;" }, data: { turbo_confirm: "¿Estás seguro de eliminar esta categoría de bodega?" } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center py-4 text-muted">No hay categorías registradas.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-center mt-3">
      <%= paginate @categories %>
    </div>
  </div>
</div>
