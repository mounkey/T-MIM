<% content_for :page_title, "Configuración Pasarela Flow" %>

<div class="container-fluid pb-5">
  <div class="row mb-4 align-items-center">
    <div class="col-md-8 text-white">
      <h3 class="mb-1"><i class="fas fa-credit-card me-2 text-warning"></i>Pasarela de Pago Online (Flow)</h3>
      <p class="lead mb-0 text-white opacity-75">Configure cómo sus clientes pagarán sus reparaciones y órdenes de trabajo por internet</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
      <%= link_to finances_path, class: "btn btn-outline-light rounded-pill px-4" do %>
        <i class="fas fa-arrow-left me-1"></i> Volver a Finanzas
      <% end %>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card bg-white border-0 shadow-sm rounded-4 p-4 p-md-5">
        
        <div class="alert alert-light border rounded-3 mb-4 p-3 d-flex align-items-center">
          <i class="fas fa-shield-alt fa-2x text-success me-3"></i>
          <div>
            <strong class="text-dark d-block">Seguridad de Claves Criptográficas (PCI-DSS)</strong>
            <small class="text-muted">Sus claves API secretas son de su exclusivo dominio. La administración de T-MIM no tiene acceso a sus contraseñas privadas de Flow.</small>
          </div>
        </div>

        <%= form_with model: @account, url: flow_settings_path, method: :patch, local: true do |f| %>
          
          <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">1. Seleccione la Modalidad de Cobro para su Taller</h5>
          
          <div class="mb-4">
            <!-- Opción A: Recaudación T-MIM -->
            <div class="form-check p-3 border rounded-3 mb-3 bg-light">
              <%= f.radio_button :flow_integration_mode, "delegated", class: "form-check-input", id: "modeDelegated", onchange: "toggleCustomKeys(false)" %>
              <label class="form-check-label ms-2" for="modeDelegated">
                <span class="fw-bold text-dark fs-6 d-block">Servicio de Recaudación T-MIM (Recomendado)</span>
                <small class="text-muted d-block">
                  No requiere crear cuenta propia en Flow. T-MIM procesa los pagos con tarjeta de sus clientes y le transfiere el monto neto recaudado a su cuenta corriente <strong>cada 15 días</strong> (días 1 y 16 de cada mes).
                </small>
                <span class="badge bg-primary-subtle text-primary mt-2">Comisión total integrada: 4,89% + IVA</span>
              </label>
            </div>

            <!-- Opción B: Credenciales Propias -->
            <div class="form-check p-3 border rounded-3">
              <%= f.radio_button :flow_integration_mode, "custom", class: "form-check-input", id: "modeCustom", onchange: "toggleCustomKeys(true)" %>
              <label class="form-check-label ms-2" for="modeCustom">
                <span class="fw-bold text-dark fs-6 d-block">Conectar mi Propia Cuenta Flow (Directo)</span>
                <small class="text-muted d-block">
                  Si su taller ya tiene contrato con Flow.cl, ingrese sus llaves aquí. Flow le transferirá su dinero al día hábil siguiente a su cuenta bancaria. 
                </small>
                <span class="badge bg-success-subtle text-success mt-2">Costo comisión T-MIM: $0</span>
              </label>
            </div>
          </div>

          <!-- Campos de llaves solo si elige cuenta propia -->
          <div id="customKeysContainer" class="p-4 border rounded-3 bg-light mb-4 <%= 'd-none' unless @account.flow_integration_mode == 'custom' %>">
            <h6 class="fw-bold text-dark mb-3">
              <i class="fas fa-key text-warning me-1"></i> Credenciales de su Cuenta Flow.cl
            </h6>
            
            <div class="mb-3">
              <%= f.label :custom_flow_api_key, "API Key Público de Flow", class: "form-label fw-bold text-dark small" %>
              <%= f.text_field :custom_flow_api_key, class: "form-control", placeholder: "Ej: 28B9-ABCD-..." %>
              <small class="text-muted">Obtenga esta clave en su portal de Flow -> Configuración -> Seguridad.</small>
            </div>

            <div class="mb-2">
              <%= f.label :custom_flow_secret_key, "Secret Key Privado de Flow", class: "form-label fw-bold text-dark small" %>
              <%= f.password_field :custom_flow_secret_key, value: @account.custom_flow_secret_key, class: "form-control", placeholder: "••••••••••••••••••••••••••••" %>
              <small class="text-muted">Esta clave es secreta y solo usted debe conocerla.</small>
            </div>
          </div>

          <div class="text-end">
            <%= f.submit "Guardar Configuración de Pasarela", class: "btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>

<script>
  function toggleCustomKeys(show) {
    var container = document.getElementById('customKeysContainer');
    if (show) {
      container.classList.remove('d-none');
    } else {
      container.classList.add('d-none');
    }
  }
</script>
