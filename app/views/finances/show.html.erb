<div class="container py-4" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to finances_path, class: "btn btn-outline-light" do %>
      <i class="fas fa-arrow-left me-1"></i> Volver a Finanzas
    <% end %>
    <div>
      <%= link_to print_pdf_finance_path(@payment_order, format: :pdf), target: "_blank", class: "btn btn-outline-danger" do %>
        <i class="fas fa-file-pdf me-1"></i> Descargar PDF
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <div>
        <h4 class="mb-0 fw-bold text-dark">Detalle de Orden <%= @payment_order.folio_number %></h4>
        <small class="text-muted"><i class="fas fa-calendar me-1"></i> Registrado el <%= @payment_order.created_at.strftime('%d/%m/%Y %H:%M') %></small>
      </div>
      <div>
        <span class="badge <%= @payment_order.mechanical_status_badge[:class] %> fs-6 me-1">
          <%= @payment_order.mechanical_status_badge[:label] %>
        </span>
        <span class="badge <%= @payment_order.financial_status_badge[:class] %> fs-6">
          <%= @payment_order.financial_status_badge[:label] %>
        </span>
      </div>
    </div>
    <div class="card-body p-4">
      <div class="row g-4 mb-4">
        <div class="col-md-6">
          <h6 class="fw-bold text-secondary text-uppercase small">Datos del Vehículo y Cliente</h6>
          <div class="p-3 bg-light rounded">
            <div><strong>Vehículo:</strong> <%= @payment_order.asset&.plate %> - <%= @payment_order.asset&.name %></div>
            <div><strong>Cliente:</strong> <%= @payment_order.client&.name || "Sin cliente asociado" %></div>
            <div><strong>Teléfono/WhatsApp:</strong> <%= @payment_order.client&.phone || "-" %></div>
          </div>
        </div>
        <div class="col-md-6">
          <h6 class="fw-bold text-secondary text-uppercase small">Resumen de Costos</h6>
          <div class="p-3 bg-light rounded">
            <div class="d-flex justify-content-between"><span>Mano de Obra:</span> <strong>$<%= number_with_delimiter(@payment_order.labor_amount.to_i) %></strong></div>
            <div class="d-flex justify-content-between"><span>Repuestos e Insumos:</span> <strong>$<%= number_with_delimiter(@payment_order.parts_amount.to_i) %></strong></div>
            <div class="d-flex justify-content-between text-danger"><span>Descuento:</span> <strong>-$<%= number_with_delimiter(@payment_order.discount_amount.to_i) %></strong></div>
            <hr class="my-2">
            <div class="d-flex justify-content-between fs-5 fw-bold text-dark"><span>Total:</span> <span>$<%= number_with_delimiter(@payment_order.total_amount.to_i) %></span></div>
            <div class="d-flex justify-content-between text-success"><span>Total Abonado:</span> <span>$<%= number_with_delimiter(@payment_order.total_paid.to_i) %></span></div>
            <div class="d-flex justify-content-between text-danger fw-bold"><span>Saldo Pendiente:</span> <span>$<%= number_with_delimiter(@payment_order.balance_due.to_i) %></span></div>
          </div>
        </div>
      </div>

      <!-- Historial de Abonos / Pagos -->
      <h5 class="fw-bold text-dark mb-3"><i class="fas fa-receipt text-success me-2"></i> Historial de Abonos y Pagos</h5>
      <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>Monto</th>
              <th>Canal / Medio</th>
              <th>Comisión Plataforma</th>
              <th>Neto Taller</th>
              <th>Observaciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @payments.any? %>
              <% @payments.each do |p| %>
                <tr>
                  <td><%= p.recorded_at.strftime('%d/%m/%Y %H:%M') %></td>
                  <td class="fw-bold text-dark">$<%= number_with_delimiter(p.amount.to_i) %></td>
                  <td>
                    <span class="badge <%= p.payment_channel_badge[:class] %>">
                      <%= p.payment_channel_label %>
                    </span>
                  </td>
                  <td class="text-danger">-$<%= number_with_delimiter((p.flow_fee + p.platform_fee).to_i) %></td>
                  <td class="fw-bold text-success">$<%= number_with_delimiter(p.net_amount.to_i) %></td>
                  <td class="small text-muted"><%= p.notes.presence || "-" %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-3 text-muted">No se han registrado abonos o pagos para esta orden.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @payment_order.balance_due > 0 %>
        <div class="card border-0 bg-light p-3">
          <h6 class="fw-bold text-dark mb-2"><i class="fas fa-plus-circle text-primary me-1"></i> Registrar Nuevo Abono</h6>
          <%= form_with url: add_payment_finance_path(@payment_order), method: :post, local: true, class: "row g-2 align-items-end" do |f| %>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Monto ($)</label>
              <%= number_field_tag :amount, @payment_order.balance_due, class: "form-control", required: true, min: 1 %>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Medio de Pago</label>
              <%= select_tag :payment_channel, options_for_select([
                ["Efectivo (Caja)", "cash"],
                ["Tarjeta (Máquina POS / Transbank)", "pos_local"],
                ["Transferencia Bancaria (Taller)", "transfer_local"],
                ["Flow (Online / Webpay)", "flow_online"]
              ]), class: "form-select" %>
            </div>
            <div class="col-md-4">
              <%= f.submit "Registrar Pago", class: "btn btn-success w-100" %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>
</div>
