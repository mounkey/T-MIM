<div class="container-fluid py-3">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <%= link_to finances_path, class: "btn btn-outline-light mb-2" do %>
        <i class="fas fa-arrow-left me-1"></i> Volver a Finanzas
      <% end %>
      <h2 class="text-white fw-bold mb-0"><i class="fas fa-file-invoice-dollar me-2 text-warning"></i> Mis Liquidaciones Quincenales (Flow)</h2>
      <p class="text-white-50">Historial de transferencias bancarias y detalle de comisiones retenidas por T-MIM.</p>
    </div>
  </div>

  <!-- Banner Explicativo del Modelo de Cobro por usar Flow -->
  <div class="card border-0 shadow-sm bg-dark text-white rounded-3 mb-4 p-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <div class="d-flex align-items-start">
          <div class="rounded-circle p-3 bg-primary bg-opacity-25 text-primary me-3 mt-1">
            <i class="fas fa-hand-holding-usd fa-2x"></i>
          </div>
          <div>
            <h5 class="fw-bold text-white mb-1">Modelo de Recaudación y Liquidación Quincenal</h5>
            <p class="text-white-50 mb-2 small">
              <strong>Por usar Flow como forma de pago:</strong> El sistema recauda las ventas pagadas por sus clientes con tarjetas y transfiere el monto neto recaudado a su cuenta bancaria <strong>cada 15 días</strong> (los días 1 y 16 de cada mes).
            </p>
            <div class="d-flex flex-wrap gap-3 small">
              <span class="text-light"><i class="fas fa-percentage text-warning me-1"></i> Comisión Total Recaudación: <strong>4,89% + IVA</strong> (Flow 2,89% + IVA | Gestión T-MIM 2,0% + IVA)</span>
              <span class="text-light"><i class="fas fa-calendar-check text-success me-1"></i> Transferencia Quincenal: <strong>Monto Neto Directo a su banco</strong></span>
              <span class="text-light"><i class="fas fa-plug text-info me-1"></i> Si tiene credenciales Flow propias: <strong>Conexión directa gratuita</strong></span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4 text-md-end mt-3 mt-md-0 border-start-md border-secondary ps-md-4">
        <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 11px;">Cuenta de Transferencia</small>
        <div class="fw-bold text-white"><%= current_user.account.bank_name.presence || 'Banco no configurado' %></div>
        <div class="small text-white-50">N° <%= current_user.account.bank_account_number.presence || 'S/N' %></div>
        <div class="small text-success mt-1"><i class="fas fa-shield-alt me-1"></i> Liquidación cada 15 días</div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm bg-white rounded-3 mb-4 p-4">
    <div class="row align-items-center">
      <div class="col-md-8">
        <h5 class="fw-bold text-dark mb-1">Saldo en Flow Acumulado (Período en Curso)</h5>
        <p class="text-muted mb-0 small">Monto líquido de ventas y abonos online que se incluirá en su próximo corte quincenal.</p>
      </div>
      <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <h2 class="fw-bold text-success mb-0">$<%= number_with_delimiter(@pending_balance.to_i) %></h2>
        <small class="text-muted"><i class="fas fa-clock me-1"></i> Por transferir al banco</small>
      </div>
    </div>
  </div>

  <!-- Tabla de Liquidaciones -->
  <div class="card border-0 shadow-sm bg-white rounded-3">
    <div class="card-header bg-white border-0 py-3">
      <h5 class="fw-bold text-dark mb-0">Historial de Liquidaciones Recibidas</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">N° Liquidación</th>
              <th>Período</th>
              <th class="text-end">Total Recaudado</th>
              <th class="text-end text-muted">Costo Flow (2.89% + IVA)</th>
              <th class="text-end text-danger">Gestión T-MIM (2.0% + IVA)</th>
              <th class="text-end text-success">Monto Transferido Neto</th>
              <th class="text-center">Estado</th>
              <th class="text-end pe-3">Detalle</th>
            </tr>
          </thead>
          <tbody>
            <% if @settlements.any? %>
              <% @settlements.each do |s| %>
                <% badge = s.status_badge %>
                <tr>
                  <td class="ps-3 fw-bold text-primary"><%= s.folio %></td>
                  <td class="small text-muted"><%= s.period_start.strftime("%d/%m/%Y") %> al <%= s.period_end.strftime("%d/%m/%Y") %></td>
                  <td class="text-end fw-semibold text-dark">$<%= number_with_delimiter(s.total_collected.to_i) %></td>
                  <td class="text-end text-muted">-$<%= number_with_delimiter(s.total_gateway_fees.to_i) %></td>
                  <td class="text-end text-danger fw-semibold">-$<%= number_with_delimiter(s.total_platform_fees.to_i) %></td>
                  <td class="text-end fw-bold text-success fs-6">$<%= number_with_delimiter(s.net_payout.to_i) %></td>
                  <td class="text-center">
                    <span class="badge <%= badge[:class] %>"><%= badge[:label] %></span>
                  </td>
                  <td class="text-end pe-3">
                    <%= link_to show_liquidacion_finances_path(settlement_id: s.id), class: "btn btn-sm btn-outline-primary" do %>
                      <i class="fas fa-eye me-1"></i> Ver Desglose
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <i class="fas fa-file-invoice fa-3x mb-3 text-secondary opacity-50"></i>
                  <p class="mb-0">Aún no tiene liquidaciones quincenales generadas.</p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
