<div class="container-fluid py-3" style="max-width: 950px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <%= link_to liquidaciones_finances_path, class: "btn btn-outline-light" do %>
      <i class="fas fa-arrow-left me-1"></i> Volver a Mis Liquidaciones
    <% end %>
    <div>
      <span class="badge <%= @settlement.status_badge[:class] %> fs-6">
        <%= @settlement.status_badge[:label] %>
      </span>
    </div>
  </div>

  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-0 py-3">
      <h4 class="mb-0 fw-bold text-dark">Liquidación Quincenal: <%= @settlement.folio %></h4>
      <small class="text-muted">Período: <%= @settlement.period_start.strftime("%d/%m/%Y") %> al <%= @settlement.period_end.strftime("%d/%m/%Y") %></small>
    </div>
    <div class="card-body p-4">
      
      <!-- Resumen Financiero -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="p-3 bg-light rounded">
            <h6 class="fw-bold text-dark text-uppercase small mb-2">Cuenta de Destino</h6>
            <div class="text-muted small"><%= @settlement.bank_details_snapshot %></div>
            <% if @settlement.transfer_reference.present? %>
              <div class="mt-2 text-success small fw-bold"><i class="fas fa-check-circle me-1"></i> Comprobante: <%= @settlement.transfer_reference %></div>
            <% end %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="p-3 bg-light rounded">
            <h6 class="fw-bold text-dark text-uppercase small mb-2">Resumen del Corte</h6>
            <div class="d-flex justify-content-between"><span>Total Recaudado en Línea:</span> <strong>$<%= number_with_delimiter(@settlement.total_collected.to_i) %></strong></div>
            <div class="d-flex justify-content-between text-muted"><span>Costo Pasarela Flow (2.89%):</span> <strong>-$<%= number_with_delimiter(@settlement.total_gateway_fees.to_i) %></strong></div>
            <div class="d-flex justify-content-between text-danger"><span>Comisión T-MIM (5.0%):</span> <strong>-$<%= number_with_delimiter(@settlement.total_platform_fees.to_i) %></strong></div>
            <hr class="my-2">
            <div class="d-flex justify-content-between fs-5 fw-bold text-success"><span>Monto Líquido Transferido:</span> <span>$<%= number_with_delimiter(@settlement.net_payout.to_i) %></span></div>
          </div>
        </div>
      </div>

      <!-- Detalle por Transacción -->
      <h5 class="fw-bold text-dark mb-3"><i class="fas fa-receipt text-primary me-2"></i> Detalle de Ventas y Abonos Online Incluidos</h5>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Fecha</th>
              <th>N° Orden</th>
              <th>Vehículo / Cliente</th>
              <th class="text-end">Monto Bruto</th>
              <th class="text-end text-muted">Cobro Flow (2.89%)</th>
              <th class="text-end text-danger">Comisión T-MIM (5%)</th>
              <th class="text-end text-success">Neto Depositado</th>
            </tr>
          </thead>
          <tbody>
            <% if @payments.any? %>
              <% @payments.each do |p| %>
                <tr>
                  <td class="small"><%= p.recorded_at.strftime("%d/%m/%Y %H:%M") %></td>
                  <td class="fw-bold text-primary"><%= p.payment_order&.folio_number || "-" %></td>
                  <td><%= p.payment_order&.asset&.plate %> - <%= p.payment_order&.client&.name %></td>
                  <td class="text-end fw-semibold text-dark">$<%= number_with_delimiter(p.amount.to_i) %></td>
                  <td class="text-end text-muted">-$<%= number_with_delimiter(p.flow_fee.to_i) %></td>
                  <td class="text-end text-danger">-$<%= number_with_delimiter(p.platform_fee.to_i) %></td>
                  <td class="text-end fw-bold text-success">$<%= number_with_delimiter(p.net_amount.to_i) %></td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-3 text-muted">No hay transacciones asociadas a esta liquidación.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>
