<%= turbo_frame_tag "modal_body" do %>
  <h2 class="text-center mb-4">Cambiar Contraseña</h2>

  <%= simple_form_for(@user, url: update_password_user_path(@user), method: :patch, defaults: { label: false }) do |f| %>
    <%= f.error_notification %>

    <div class="mb-3">
      <%= f.input :password, placeholder: "Nueva Contraseña", input_html: { class: "form-control-lg" } %>
    </div>
    <div class="mb-3">
      <%= f.input :password_confirmation, placeholder: "Confirmar Nueva Contraseña", input_html: { class: "form-control-lg" } %>
    </div>

    <div class="mt-4 clearfix">
      <%= f.button :submit, "Cambiar Contraseña", class: "btn-submit-custom" %>
    </div>
  <% end %>
<% end %>
