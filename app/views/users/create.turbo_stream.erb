<%= turbo_stream.update "flash" do %>
  <%= render partial: "shared/flash" %>
<% end %>

<% if current_user.admin? %>
  <%= turbo_stream.update "users_grid" do %>
    <table class="table table-hover align-middle" style="color: #333 !important;">
      <thead class="table-light">
        <tr>
          <th class="text-dark">Nombre</th>
          <th class="text-dark">RUT</th>
          <th class="text-dark">Roles</th>
          <th class="text-dark">Fecha Incorporación</th>
          <th class="text-end text-dark">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="text-dark"><%= user.name %></td>
            <td class="text-dark"><%= user.run %></td>
            <td class="text-dark"><%= user.role.capitalize %></td>
            <td class="text-dark"><%= user.created_at.strftime("%d/%m/%Y") %></td>
            <td class="text-end">
              <%= link_to edit_user_path(user), class: "action-icon edit", title: "Editar", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
                <i class="fas fa-pencil-alt"></i>
              <% end %>
              <%= link_to change_password_user_path(user), class: "text-warning me-2", title: "Cambiar Contraseña", style: "text-decoration:none;", data: { turbo_frame: "modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('mainModal')).show()" do %>
                <i class="fas fa-key"></i>
              <% end %>
              <%= button_to user_path(user), method: :delete, class: "btn btn-link action-icon delete p-0 border-0", form: { style: "display:inline-block;" }, data: { turbo_confirm: "¿Estás seguro?" }, title: "Eliminar" do %>
                <i class="fas fa-trash"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<!-- Trigger Stimulus Controller INSIDE the modal frame to force execution -->
<%= turbo_stream.update "modal_body" do %>
  <div data-controller="modal-close"></div>
<% end %>
