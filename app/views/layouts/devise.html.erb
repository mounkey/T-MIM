<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "T-MIM | Talleres y Mantención Inteligente" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag 'favicon.ico' %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      .split-screen {
        display: flex;
        height: 100vh;
        width: 100vw;
      }
      .left-pane {
        width: 50%;
        background-color: white;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .right-pane {
        width: 50%;
        background-color: #041C36;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 5rem;
      }
      .right-pane a {
        color: white;
        text-decoration: underline;
      }
      .form-control {
        border-radius: 20px;
        padding: 0.75rem 1.5rem;
      }
      .btn-login {
        border-radius: 20px;
        background-color: white;
        color: #041C36;
        font-weight: bold;
        padding: 0.75rem;
        width: 100%;
        border: none;
      }
      .btn-login:hover {
        background-color: #f0f0f0;
      }
    </style>
  </head>

  <body style="margin: 0;">
    <div class="split-screen">
      <div class="left-pane">
        <%= image_tag "logo.png", style: "max-width: 80%;" %>
        <div class="text-center mt-3 text-muted">
          <!-- Optional Tagline if needed, keeping it clean for now -->
        </div>
      </div>
      <div class="right-pane">
        <%= yield %>

        <% if alert %>
          <div class="alert alert-danger position-absolute bottom-0 end-0 m-4" role="alert">
            <%= alert %>
          </div>
        <% end %>
        <% if notice %>
          <div class="alert alert-info position-absolute bottom-0 end-0 m-4" role="alert">
            <%= notice %>
          </div>
        <% end %>
      </div>
    </div>
  </body>
</html>
