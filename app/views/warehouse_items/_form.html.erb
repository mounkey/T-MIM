<%= turbo_frame_tag "modal_body" do %>
  <h2 class="text-center mb-4"><%= @warehouse_item.new_record? ? "Nuevo Repuesto / Insumo" : "Editar Repuesto" %></h2>

  <%= simple_form_for(@warehouse_item,
      url: @warehouse_item.persisted? ? warehouse_item_path(@warehouse_item) : warehouse_items_path,
      html: { class: "p-1 text-start", data: { turbo_frame: "modal_body" } }) do |f| %>

    <div class="mb-3">
      <%= f.label :name, "Nombre del Repuesto / Insumo *", class: "form-label text-white fw-bold d-block" %>
      <%= f.input :name, label: false, placeholder: "Ej. Aceite Sintético 5W30, Filtro de Aire...", input_html: { class: "form-control-lg" } %>
    </div>

    <% available_categories = (WarehouseCategory.order(:name).pluck(:name) + ["General", "Lubricantes", "Filtros", "Frenos", "Suspensión y Dirección", "Eléctrico e Iluminación", "Neumáticos y Ruedas", "Motor y Transmisión"]).uniq %>
    <% available_units = (MeasurementUnit.order(:name).pluck(:name) + ["Unidad", "Litro", "Bidón (5L)", "Tambor (200L)", "Juego / Kit", "Par", "Metro", "Kilogramo", "Hora"]).uniq %>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <%= f.label :sku, "Código / SKU (Opcional)", class: "form-label text-white fw-bold d-block" %>
        <%= f.input :sku, label: false, placeholder: "Ej. SKU-98765 o PH-4967", input_html: { class: "form-control-lg" } %>
      </div>
      <div class="col-md-6">
        <%= f.label :category, "Categoría", class: "form-label text-white fw-bold d-block" %>
        <%= f.input :category, label: false, collection: available_categories, include_blank: false, input_html: { class: "form-select-lg" } %>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <%= f.label :unit, "Unidad de Medida", class: "form-label text-white fw-bold d-block" %>
        <%= f.input :unit, label: false, collection: available_units, include_blank: false, input_html: { class: "form-select-lg" } %>
      </div>
      <div class="col-md-4">
        <%= f.label :stock_quantity, "Stock Inicial", class: "form-label text-white fw-bold d-block" %>
        <%= f.input :stock_quantity, label: false, placeholder: "0", input_html: { class: "form-control-lg" } %>
      </div>
      <div class="col-md-4">
        <%= f.label :minimum_stock, "Mínimo Alerta", class: "form-label text-white fw-bold d-block" %>
        <%= f.input :minimum_stock, label: false, placeholder: "2", input_html: { class: "form-control-lg" } %>
      </div>
    </div>

    <% if current_user.admin? %>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <%= f.label :cost_price, "Precio Costo ($)", class: "form-label text-white fw-bold d-block" %>
          <%= f.input :cost_price, label: false, placeholder: "Ej. 15000", input_html: { class: "form-control-lg" } %>
        </div>
        <div class="col-md-6">
          <%= f.label :sale_price, "Precio Venta ($)", class: "form-label text-white fw-bold d-block" %>
          <%= f.input :sale_price, label: false, placeholder: "Ej. 25000", input_html: { class: "form-control-lg" } %>
        </div>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :location, "Ubicación en Taller (Opcional)", class: "form-label text-white fw-bold d-block" %>
      <%= f.input :location, label: false, placeholder: "Ej. Estante A - Nivel 2", input_html: { class: "form-control-lg" } %>
    </div>

    <div class="mb-3">
      <%= f.label :description, "Descripción o Notas (Opcional)", class: "form-label text-white fw-bold d-block" %>
      <%= f.input :description, as: :text, label: false, placeholder: "Especificaciones...", input_html: { rows: 2, class: "form-control-lg" } %>
    </div>

    <div class="mt-4 clearfix">
      <%= f.button :submit, @warehouse_item.persisted? ? "Actualizar" : "Guardar", class: "btn-submit-custom" %>
    </div>

  <% end %>
<% end %>
