<% content_for :page_title, "Kardex de Bodega - #{@warehouse_item.name}" %>

<div class="container-fluid pb-5">
  <div class="row g-4 mb-4">
    <!-- Item Info Card -->
    <div class="col-12 col-lg-4">
      <div class="card shadow-sm border-0 h-100 bg-white">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
              <h4 class="fw-bold text-dark mb-1"><%= @warehouse_item.name %></h4>
              <% if @warehouse_item.sku.present? %>
                <span class="badge bg-light text-secondary border"><i class="fas fa-barcode me-1"></i><%= @warehouse_item.sku %></span>
              <% end %>
            </div>
            <%= link_to edit_warehouse_item_path(@warehouse_item), class: "btn btn-sm btn-outline-primary" do %>
              <i class="fas fa-edit"></i>
            <% end %>
          </div>

          <hr>

          <!-- Stocks Breakdown -->
          <div class="mb-3 p-3 bg-light rounded">
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Stock Físico (En Taller):</span>
              <span class="fw-bold fs-6"><%= @warehouse_item.stock_quantity %> <%= @warehouse_item.unit %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Reservados para Autos ⏳:</span>
              <span class="fw-bold text-warning fs-6"><%= @warehouse_item.reserved_quantity %> <%= @warehouse_item.unit %></span>
            </div>
            <div class="d-flex justify-content-between pt-2 border-top">
              <span class="fw-bold text-dark">Disponibles para Nuevos Trabajos ✅:</span>
              <span class="fw-bold text-success fs-5"><%= @warehouse_item.available_stock %> <%= @warehouse_item.unit %></span>
            </div>
          </div>

          <div class="mb-2">
            <small class="text-muted d-block">Categoría:</small>
            <span class="fw-semibold"><%= @warehouse_item.category %></span>
          </div>

          <div class="mb-2">
            <small class="text-muted d-block">Ubicación en Taller:</small>
            <span class="fw-semibold"><%= @warehouse_item.location.presence || "No especificada" %></span>
          </div>

          <% if current_user.admin? %>
            <div class="mt-3 p-2 bg-light rounded border">
              <div class="d-flex justify-content-between small mb-1">
                <span class="text-muted">Precio Costo / Compra:</span>
                <span class="fw-bold text-dark">$<%= number_with_delimiter(@warehouse_item.cost_price.to_i) %></span>
              </div>
              <div class="d-flex justify-content-between small">
                <span class="text-muted">Precio Venta Sugerido:</span>
                <span class="fw-bold text-primary">$<%= number_with_delimiter(@warehouse_item.sale_price.to_i) %></span>
              </div>
            </div>
          <% end %>

          <!-- Quick Stock Entry Form -->
          <div class="mt-4 pt-3 border-top">
            <h6 class="fw-bold text-dark mb-2"><i class="fas fa-plus-circle text-success me-1"></i> Registrar Ingreso / Compra</h6>
            <%= form_with url: add_stock_warehouse_item_path(@warehouse_item), method: :post, local: true do |f| %>
              <div class="input-group mb-2">
                <%= f.number_field :quantity, step: 0.1, min: 0.1, placeholder: "Cantidad a sumar", class: "form-control", required: true %>
                <span class="input-group-text bg-white"><%= @warehouse_item.unit %></span>
              </div>
              <div class="mb-2">
                <%= f.text_field :notes, placeholder: "Motivo / Factura proveedor...", class: "form-control form-control-sm" %>
              </div>
              <%= f.submit "+ Agregar a Bodega", class: "btn btn-success btn-sm w-100 fw-bold" %>
            <% end %>
          </div>

          <div class="mt-3">
            <%= link_to "Volver a Bodega", warehouse_items_path, class: "btn btn-outline-secondary btn-sm w-100 rounded-pill" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Kardex History Table -->
    <div class="col-12 col-lg-8">
      <div class="card shadow-sm border-0 h-100 bg-white">
        <div class="card-header bg-white py-3">
          <h5 class="fw-bold text-dark mb-0"><i class="fas fa-history text-info me-2"></i>Kardex - Movimientos de Stock</h5>
        </div>
        <div class="card-body p-0 table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3 text-dark">Fecha / Hora</th>
                <th class="text-dark">Tipo Movimiento</th>
                <th class="text-center text-dark">Cantidad</th>
                <th class="text-dark">Vehículo / Detalle</th>
                <th class="text-dark">Responsable</th>
              </tr>
            </thead>
            <tbody>
              <% if @stock_movements.any? %>
                <% @stock_movements.each do |mov| %>
                  <tr>
                    <td class="ps-3">
                      <div class="fw-bold text-dark"><%= mov.created_at.strftime("%d/%m/%Y") %></div>
                      <small class="text-muted"><%= mov.created_at.strftime("%H:%M") %></small>
                    </td>
                    <td>
                      <span class="badge <%= mov.type_badge_class %>"><%= mov.type_label %></span>
                    </td>
                    <td class="text-center fw-bold fs-6">
                      <%= mov.entry? ? "+#{mov.quantity}" : "-#{mov.quantity}" %> <%= @warehouse_item.unit %>
                    </td>
                    <td>
                      <% if mov.asset %>
                        <div><i class="fas fa-car me-1 text-secondary"></i><strong><%= mov.asset.plate.presence || mov.asset.name %></strong></div>
                        <% if mov.asset.client %>
                          <small class="text-muted">(Cliente: <%= mov.asset.client.name %>)</small>
                        <% end %>
                      <% end %>
                      <% if mov.notes.present? %>
                        <div class="small text-muted"><%= mov.notes %></div>
                      <% end %>
                    </td>
                    <td>
                      <small class="text-dark"><%= mov.user.name.presence || mov.user.email %></small>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted">
                    <p class="mb-0">No hay movimientos registrados en el kardex aún.</p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="d-flex justify-content-center p-3">
          <%= paginate @stock_movements %>
        </div>
      </div>
    </div>
  </div>
</div>
