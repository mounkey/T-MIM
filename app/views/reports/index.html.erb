<% content_for :page_title, "Centro de Reportes e Informes" %>

<div class="container-fluid pb-5">
  <!-- Header / Intro Card -->
  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h4 class="fw-bold text-dark mb-1"><i class="fas fa-chart-line text-primary me-2"></i>Centro de Informes T-MIM</h4>
        <p class="text-muted mb-0">Genera, visualiza y exporta en PDF los balances de inventario, valorizaciones y fichas técnicas de vehículos.</p>
      </div>
      <div>
        <%= link_to inventory_report_path(format: :pdf), class: "btn btn-primary shadow-sm", target: "_blank" do %>
          <i class="fas fa-file-pdf me-1"></i> Descargar Stock Global (PDF)
        <% end %>
      </div>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Total Vehículos</h6>
            <h3 class="fw-bold mb-0 text-dark"><%= @total_assets_count %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 text-primary">
            <i class="fas fa-car fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Repuestos / SKUs</h6>
            <h3 class="fw-bold mb-0 text-dark"><%= @total_items_count %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 text-info">
            <i class="fas fa-boxes fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Stock Crítico / Bajo</h6>
            <h3 class="fw-bold mb-0 <%= @low_stock_count > 0 ? 'text-danger' : 'text-success' %>"><%= @low_stock_count %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 <%= @low_stock_count > 0 ? 'text-danger' : 'text-success' %>">
            <i class="fas fa-exclamation-triangle fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Valor Inventario (Costo)</h6>
            <h4 class="fw-bold mb-0 text-dark">$<%= number_with_delimiter(@inventory_cost_total.to_i) %></h4>
          </div>
          <div class="bg-light rounded-circle p-3 text-success">
            <i class="fas fa-dollar-sign fa-2x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Report Modules Grid -->
  <div class="row g-4">
    <!-- 1. Reporte de Inventario y Bodega -->
    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 h-100 bg-white">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-3 p-3">
              <i class="fas fa-warehouse fa-2x"></i>
            </div>
            <div>
              <h5 class="fw-bold text-dark mb-0">1. Informe de Stock y Bodega</h5>
              <small class="text-muted">Valorización al costo vs venta, alertas de stock y Kardex</small>
            </div>
          </div>
        </div>
        <div class="card-body p-4">
          <p class="text-muted small">
            Genera un informe financiero y logístico completo del inventario actual de repuestos e insumos. Incluye desglose por categorías, cálculo de margen proyectado, detección de quiebres de stock y últimos consumos en órdenes de servicio.
          </p>
          <ul class="list-unstyled small text-secondary mb-4">
            <li><i class="fas fa-check-circle text-success me-2"></i>Inversión total y proyección de ganancia estimada</li>
            <li><i class="fas fa-check-circle text-success me-2"></i>Control de repuestos bajo stock mínimo y agotados</li>
            <li><i class="fas fa-check-circle text-success me-2"></i>Resumen de movimientos recientes de Kardex</li>
          </ul>
          <div class="d-flex gap-2">
            <%= link_to inventory_report_path, class: "btn btn-outline-primary w-50" do %>
              <i class="fas fa-eye me-1"></i> Ver en Pantalla
            <% end %>
            <%= link_to inventory_report_path(format: :pdf), class: "btn btn-primary w-50", target: "_blank" do %>
              <i class="fas fa-file-pdf me-1"></i> Descargar PDF
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Proyección de Mantenimientos Preventivos -->
    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 h-100 bg-white">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-warning text-dark rounded-3 p-3">
              <i class="fas fa-calendar-check fa-2x"></i>
            </div>
            <div>
              <h5 class="fw-bold text-dark mb-0">2. Proyección de Mantenimiento</h5>
              <small class="text-muted">Estimación por odómetro, horómetro y fechas límite</small>
            </div>
          </div>
        </div>
        <div class="card-body p-4">
          <p class="text-muted small">
            Monitoreo preventivo que analiza el uso diario promedio de cada vehículo y predice los mantenimientos programados para los próximos 30/60 días según sus planes asociados.
          </p>
          <ul class="list-unstyled small text-secondary mb-4">
            <li><i class="fas fa-check-circle text-success me-2"></i>Cálculo automatizado de desgaste por uso diario</li>
            <li><i class="fas fa-check-circle text-success me-2"></i>Alertas de mantenimientos vencidos y próximos a vencer</li>
            <li><i class="fas fa-check-circle text-success me-2"></i>Exportable para planificación del taller</li>
          </ul>
          <div class="d-flex gap-2">
            <%= link_to maintenance_projection_report_path, class: "btn btn-outline-warning text-dark w-50" do %>
              <i class="fas fa-eye me-1"></i> Ver Proyección
            <% end %>
            <%= link_to maintenance_projection_report_path(format: :pdf), class: "btn btn-dark w-50", target: "_blank" do %>
              <i class="fas fa-file-pdf me-1"></i> Descargar PDF
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Selector de Reportes por Vehículo -->
    <div class="col-12">
      <div class="card shadow-sm border-0 bg-white">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
          <h5 class="fw-bold text-dark mb-1"><i class="fas fa-car-side text-primary me-2"></i>Informes Específicos por Vehículo</h5>
          <small class="text-muted">Selecciona un vehículo de la flota o cliente para emitir su informe de última reparación o su historial integral de vida.</small>
        </div>
        <div class="card-body p-4">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="color: #333 !important;">
              <thead class="table-light">
                <tr>
                  <th class="ps-3 text-dark">Vehículo / Patente</th>
                  <th class="text-dark">Propietario / Cliente</th>
                  <th class="text-dark">Categoría</th>
                  <th class="text-center text-dark">Última OT / Estado</th>
                  <th class="text-end pe-3 text-dark">Reportes Disponibles</th>
                </tr>
              </thead>
              <tbody>
                <% if @assets.any? %>
                  <% @assets.each do |asset| %>
                    <% latest_ot = asset.latest_payment_order %>
                    <tr>
                      <td class="ps-3">
                        <div class="fw-bold"><%= link_to asset.name, asset_path(asset), class: "text-decoration-none text-dark" %></div>
                        <span class="badge bg-light text-dark border"><i class="fas fa-barcode me-1"></i><%= asset.plate.presence || "S/N" %></span>
                        <small class="text-muted ms-1"><%= asset.make %> <%= asset.model %> (<%= asset.year %>)</small>
                      </td>
                      <td>
                        <% if asset.client %>
                          <span class="fw-semibold"><%= asset.client.name %></span>
                        <% else %>
                          <span class="text-muted">Sin cliente asignado</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge bg-secondary"><%= asset.asset_category&.name || "General" %></span>
                      </td>
                      <td class="text-center">
                        <% if latest_ot %>
                          <span class="badge <%= latest_ot.mechanical_status_badge[:class] %>">
                            <%= latest_ot.folio_number %> - <%= latest_ot.mechanical_status_badge[:label] %>
                          </span>
                        <% else %>
                          <span class="text-muted small">Sin intervenciones registradas</span>
                        <% end %>
                      </td>
                      <td class="text-end pe-3">
                        <div class="btn-group btn-group-sm">
                          <%= link_to vehicle_latest_repair_report_path(asset), class: "btn btn-outline-primary", title: "Ver Última Reparación (OT Actual)" do %>
                            <i class="fas fa-wrench me-1"></i> Última Reparación
                          <% end %>
                          <%= link_to vehicle_latest_repair_report_path(asset, format: :pdf), class: "btn btn-primary", target: "_blank", title: "Descargar PDF Última Reparación" do %>
                            <i class="fas fa-file-pdf"></i>
                          <% end %>
                          <%= link_to vehicle_full_history_report_path(asset), class: "btn btn-outline-dark ms-2", title: "Ver Historial Completo de Vida" do %>
                            <i class="fas fa-history me-1"></i> Historial Completo
                          <% end %>
                          <%= link_to vehicle_full_history_report_path(asset, format: :pdf), class: "btn btn-dark", target: "_blank", title: "Descargar PDF Historial Completo" do %>
                            <i class="fas fa-file-pdf"></i>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center py-4 text-muted">No hay vehículos registrados en el sistema.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
