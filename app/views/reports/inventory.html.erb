<% content_for :page_title, "Informe de Stock y Valoración de Bodega" %>

<div class="container-fluid pb-5">
  <!-- Actions Header Card -->
  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <%= link_to reports_path, class: "btn btn-sm btn-outline-secondary" do %>
            <i class="fas fa-arrow-left"></i>
          <% end %>
          <h4 class="fw-bold text-dark mb-0">Informe de Stock y Valorización de Bodega</h4>
        </div>
        <p class="text-muted mb-0 small">Reporte de existencias físicas, valorización total (costo vs. venta), stock crítico y movimientos de Kardex.</p>
      </div>
      <div class="d-flex gap-2">
        <%= link_to inventory_report_path(format: :pdf, category: params[:category], stock_status: params[:stock_status]), class: "btn btn-primary shadow-sm", target: "_blank" do %>
          <i class="fas fa-file-pdf me-1"></i> Descargar Informe PDF
        <% end %>
      </div>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Inversión Total (Costo)</h6>
            <h3 class="fw-bold mb-0 text-dark">$<%= number_with_delimiter(@total_cost_valuation.to_i) %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 text-secondary">
            <i class="fas fa-coins fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Proyección Venta Total</h6>
            <h3 class="fw-bold mb-0 text-primary">$<%= number_with_delimiter(@total_sale_valuation.to_i) %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 text-primary">
            <i class="fas fa-cash-register fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Margen Bruto Estimado</h6>
            <h3 class="fw-bold mb-0 text-success">+$<%= number_with_delimiter(@estimated_profit.to_i) %></h3>
          </div>
          <div class="bg-light rounded-circle p-3 text-success">
            <i class="fas fa-chart-pie fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
      <div class="card shadow-sm border-0 p-3 h-100 bg-white">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h6 class="text-uppercase text-muted fw-bold mb-1 small">Unidades Físicas / SKUs</h6>
            <h4 class="fw-bold mb-0 text-dark"><%= @total_units.to_i %> <span class="fs-6 text-muted fw-normal">(en <%= @total_skus %> SKUs)</span></h4>
            <small class="text-muted">Disp: <%= @total_available_units.to_i %> | Resv: <%= @total_reserved_units.to_i %></small>
          </div>
          <div class="bg-light rounded-circle p-3 text-info">
            <i class="fas fa-cubes fa-2x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Card -->
  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
      <%= form_with url: inventory_report_path, method: :get, local: true, class: "row g-2 align-items-center" do |f| %>
        <div class="col-12 col-md-5">
          <label class="small text-muted fw-bold">Filtrar por Categoría:</label>
          <%= f.select :category, 
              options_for_select([["Todas las categorías", ""], "Lubricantes", "Filtros", "Frenos", "Suspensión", "Eléctrico", "Neumáticos", "General"], params[:category]), 
              {}, 
              class: "form-select bg-light border-0", 
              onchange: "this.form.submit()" %>
        </div>
        <div class="col-12 col-md-5">
          <label class="small text-muted fw-bold">Filtrar por Estado de Stock:</label>
          <%= f.select :stock_status, 
              options_for_select([["Todos los niveles de stock", ""], ["Alerta: Stock Bajo o Mínimo", "low_stock"], ["Crítico: Agotados (Stock 0)", "out_of_stock"], ["Stock Óptimo", "optimal"]], params[:stock_status]), 
              {}, 
              class: "form-select bg-light border-0", 
              onchange: "this.form.submit()" %>
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end">
          <%= f.submit "Aplicar Filtros", class: "btn btn-outline-secondary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Detailed Inventory Table Card -->
  <div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
      <h5 class="fw-bold text-dark mb-0"><i class="fas fa-list-alt text-primary me-2"></i>Detalle de Existencias y Valorización</h5>
      <span class="badge bg-light text-dark border"><%= @warehouse_items.count %> Artículos listados</span>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-hover align-middle mb-0" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="ps-4 text-dark">SKU / Repuesto</th>
            <th class="text-dark">Categoría</th>
            <th class="text-center text-dark">Stock Físico</th>
            <th class="text-center text-dark">Stock Disponible</th>
            <th class="text-end text-dark">Costo Unit.</th>
            <th class="text-end text-dark">Total Costo</th>
            <th class="text-end text-dark">Precio Venta</th>
            <th class="text-end text-dark">Total Venta</th>
            <th class="text-center text-dark pe-4">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% if @warehouse_items.any? %>
            <% @warehouse_items.each do |item| %>
              <% badge = item.stock_status_badge %>
              <% total_cost = (item.stock_quantity * (item.cost_price || 0)) %>
              <% total_sale = (item.stock_quantity * (item.sale_price || 0)) %>
              <tr>
                <td class="ps-4">
                  <div class="fw-bold"><%= item.name %></div>
                  <% if item.sku.present? %>
                    <small class="text-muted"><i class="fas fa-barcode me-1"></i><%= item.sku %></small>
                  <% end %>
                  <% if item.location.present? %>
                    <small class="text-muted ms-2"><i class="fas fa-map-marker-alt me-1"></i><%= item.location %></small>
                  <% end %>
                </td>
                <td><span class="badge bg-light text-secondary border"><%= item.category %></span></td>
                <td class="text-center fw-bold"><%= item.stock_quantity %> <%= item.unit %></td>
                <td class="text-center">
                  <span class="badge bg-success-subtle text-success border border-success fw-bold"><%= item.available_stock %> <%= item.unit %></span>
                </td>
                <td class="text-end text-muted">$<%= number_with_delimiter(item.cost_price.to_i) %></td>
                <td class="text-end fw-semibold">$<%= number_with_delimiter(total_cost.to_i) %></td>
                <td class="text-end text-muted">$<%= number_with_delimiter(item.sale_price.to_i) %></td>
                <td class="text-end fw-bold text-primary">$<%= number_with_delimiter(total_sale.to_i) %></td>
                <td class="text-center pe-4">
                  <span class="badge <%= badge[:class] %>"><%= badge[:label] %></span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="fas fa-box-open fa-3x mb-3 text-secondary opacity-50"></i>
                <p class="h6">No se encontraron artículos con los filtros seleccionados.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Kardex Movements Summary Card -->
  <div class="card shadow-sm border-0 bg-white">
    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
      <h5 class="fw-bold text-dark mb-0"><i class="fas fa-exchange-alt text-primary me-2"></i>Últimos Movimientos de Kardex (Entradas / Consumos)</h5>
      <small class="text-muted">Registro reciente de ingresos de mercadería y salidas aplicadas a vehículos.</small>
    </div>
    <div class="card-body p-0 table-responsive">
      <table class="table table-hover align-middle mb-0" style="color: #333 !important;">
        <thead class="table-light">
          <tr>
            <th class="ps-4 text-dark">Fecha / Hora</th>
            <th class="text-dark">Repuesto / Insumo</th>
            <th class="text-dark">Tipo de Movimiento</th>
            <th class="text-center text-dark">Cantidad</th>
            <th class="text-dark">Vehículo Destino</th>
            <th class="text-dark">Responsable</th>
            <th class="text-dark pe-4">Notas / Folio</th>
          </tr>
        </thead>
        <tbody>
          <% if @recent_movements.any? %>
            <% @recent_movements.each do |mov| %>
              <tr>
                <td class="ps-4 small text-muted"><%= mov.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td><strong><%= mov.warehouse_item&.name %></strong></td>
                <td><span class="badge <%= mov.type_badge_class %>"><%= mov.type_label %></span></td>
                <td class="text-center fw-bold"><%= mov.quantity %> <%= mov.warehouse_item&.unit %></td>
                <td>
                  <% if mov.asset %>
                    <span class="badge bg-light text-dark border"><i class="fas fa-car me-1"></i><%= mov.asset.plate.presence || mov.asset.name %></span>
                  <% else %>
                    <span class="text-muted">-</span>
                  <% end %>
                </td>
                <td><small><%= mov.user&.name || "-" %></small></td>
                <td class="pe-4 small text-muted"><%= mov.notes.presence || "-" %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">Sin movimientos de Kardex registrados recientemente.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
