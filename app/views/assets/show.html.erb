<div class="container-fluid py-4">
  <!-- Header Card -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <div class="bg-light rounded-circle p-3">
          <i class="fas <%= @asset.asset_category.icon %> fa-2x text-primary"></i>
        </div>
        <div>
          <h2 class="mb-0 fw-bold text-dark"><%= @asset.name %></h2>
          <div class="text-muted small">
            <span class="me-3"><i class="fas fa-barcode me-1"></i> <%= @asset.plate.presence || "S/N" %></span>
            <% if @asset.tag %>
              <span class="badge" style="background-color: <%= @asset.tag.color %>;"><%= @asset.tag.name %></span>
            <% else %>
              <span class="badge bg-secondary">Sin Etiqueta</span>
            <% end %>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap justify-content-end">
        <%= link_to vehicle_latest_repair_report_path(@asset), class: "btn btn-outline-primary" do %>
          <i class="fas fa-wrench me-1"></i> Última Reparación
        <% end %>
        <%= link_to vehicle_full_history_report_path(@asset), class: "btn btn-outline-dark" do %>
          <i class="fas fa-history me-1"></i> Historial Completo
        <% end %>
        <%= link_to vehicle_full_history_report_path(@asset, format: :pdf), class: "btn btn-dark", target: "_blank" do %>
          <i class="fas fa-file-pdf me-1"></i> PDF
        <% end %>
        <%= link_to edit_asset_path(@asset), class: "btn btn-outline-secondary", data: { turbo_frame: "large_modal_body" }, onclick: "new bootstrap.Modal(document.getElementById('largeModal')).show()" do %>
          <i class="fas fa-edit me-1"></i> Editar
        <% end %>
        <%= link_to assets_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-arrow-left me-1"></i> Volver
        <% end %>
      </div>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <ul class="nav nav-tabs mb-4" id="assetTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active fw-bold" id="technical-tab" data-bs-toggle="tab" data-bs-target="#technical" type="button" role="tab" aria-controls="technical" aria-selected="true">
        <i class="fas fa-clipboard-list me-2"></i>Ficha Técnica
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab" aria-controls="history" aria-selected="false">
        <i class="fas fa-history me-2"></i>Historial de Vida
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-bold" id="providers-tab" data-bs-toggle="tab" data-bs-target="#providers" type="button" role="tab" aria-controls="providers" aria-selected="false">
        <i class="fas fa-users-cog me-2"></i>Proveedores Sugeridos
      </button>
    </li>
  </ul>

  <!-- Tabs Content -->
  <div class="tab-content" id="assetTabsContent">

    <!-- Tab 1: Ficha Técnica -->
    <div class="tab-pane fade show active" id="technical" role="tabpanel" aria-labelledby="technical-tab">
      <div class="row g-4">
        <!-- Main Info -->
        <div class="col-md-8">
          <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-bold text-primary">Información General</div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">Propietario</div>
                <div class="col-sm-8 fw-bold text-dark">
                  <% if @asset.client %>
                    <%= link_to @asset.client.name, client_path(@asset.client), class: "text-decoration-none text-primary" %>
                    <% if @asset.client.phone.present? %>
                      <small class="text-muted ms-2">(<%= @asset.client.phone %>)</small>
                    <% end %>
                  <% else %>
                    <span class="text-muted fw-normal">Sin Propietario Asignado</span>
                  <% end %>
                </div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">Marca</div>
                <div class="col-sm-8 fw-bold text-dark"><%= @asset.make %></div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">Modelo</div>
                <div class="col-sm-8 fw-bold text-dark"><%= @asset.model %></div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">Año</div>
                <div class="col-sm-8 fw-bold text-dark"><%= @asset.year %></div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">N° Serie</div>
                <div class="col-sm-8 fw-bold text-dark"><%= @asset.serial_number %></div>
              </div>
              <div class="row mb-3">
                <div class="col-sm-4 text-muted">Ubicación</div>
                <div class="col-sm-8 fw-bold text-dark"><%= @asset.location %></div>
              </div>
              <div class="row">
                <div class="col-sm-4 text-muted">Descripción</div>
                <div class="col-sm-8 text-dark"><%= @asset.description %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Meters & Status -->
        <div class="col-md-4">
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold text-primary">Estado & Medidores</div>
            <div class="card-body">
              <div class="mb-3">
                <label class="small text-muted text-uppercase">Estado Actual</label>
                <div class="mt-1">
                  <% case @asset.status %>
                  <% when 'operativa' %>
                    <span class="badge bg-success w-100 py-2">OPERATIVA</span>
                  <% when 'en_mantencion' %>
                    <span class="badge bg-warning text-dark w-100 py-2">EN MANTENCIÓN</span>
                  <% when 'fuera_de_servicio' %>
                    <span class="badge bg-danger w-100 py-2">FUERA DE SERVICIO</span>
                  <% end %>
                </div>
              </div>
              <hr>
              <% @asset.meters.each do |meter| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted"><%= meter.name %> (<%= meter.unit %>)</span>
                  <span class="fw-bold fs-5 text-dark"><%= meter.current_value %></span>
                </div>
              <% end %>
              <div class="d-grid mt-3">
                 <!-- Meter Update Button could go here -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Historial de Vida -->
    <div class="tab-pane fade" id="history" role="tabpanel" aria-labelledby="history-tab">
      <div class="card shadow-sm border-0">
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="bg-light">
                <tr>
                  <th class="ps-4 py-3 text-secondary small text-uppercase">Fecha / Hora</th>
                  <th class="py-3 text-secondary small text-uppercase">Evento / Tarea</th>
                  <th class="py-3 text-secondary small text-uppercase">Responsable (Interno)</th>
                  <th class="py-3 text-secondary small text-uppercase">Ejecutor (Externo)</th>
                  <th class="py-3 text-secondary small text-uppercase text-center">Calificación</th>
                </tr>
              </thead>
              <tbody>
                <% if @logbook_records.any? %>
                  <% @logbook_records.each do |record| %>
                    <tr>
                      <td class="ps-4">
                        <div class="fw-bold text-dark"><%= record.recorded_at&.strftime("%d/%m/%Y") %></div>
                        <div class="small text-muted"><%= record.recorded_at&.strftime("%H:%M:%S") %></div>
                      </td>
                      <td>
                        <div class="text-dark"><%= record.notes.presence || "Registro de Actividad" %></div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="fas fa-user text-secondary small"></i>
                          </div>
                          <div>
                            <div class="small fw-bold text-dark"><%= record.user.name %></div>
                            <div class="small text-muted" style="font-size: 0.75rem;">Digitador</div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <% if record.provider %>
                          <div class="fw-bold text-primary"><%= link_to record.provider.name, provider_path(record.provider), class: "text-decoration-none" %></div>
                          <div class="small text-muted">Proveedor Externo</div>
                        <% else %>
                          <span class="badge bg-light text-secondary border">Interno</span>
                        <% end %>
                      </td>
                      <td class="text-center">
                        <% if record.provider_rating.present? %>
                          <div class="text-warning">
                            <% record.provider_rating.times do %>
                              <i class="fas fa-star"></i>
                            <% end %>
                          </div>
                        <% elsif record.provider %>
                          <span class="small text-muted">-</span>
                        <% else %>
                          <!-- Internal work doesn't have rating -->
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="5" class="text-center py-5 text-muted">
                      <i class="fas fa-history fa-2x mb-3 opacity-50"></i>
                      <p class="mb-0">No hay historial registrado aún.</p>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: Proveedores Sugeridos -->
    <div class="tab-pane fade" id="providers" role="tabpanel" aria-labelledby="providers-tab">
      <div class="row g-4">
        <% if @suggested_providers.any? %>
          <% @suggested_providers.each do |provider| %>
            <div class="col-md-6 col-xl-4">
              <div class="card shadow-sm border-0 h-100 hover-card">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="fw-bold text-dark mb-0"><%= provider.name %></h5>
                    <div class="text-warning">
                      <% (provider.rating || 0).times do %>
                        <i class="fas fa-cog"></i>
                      <% end %>
                    </div>
                  </div>
                  <div class="mb-3">
                    <% if @asset.tag %>
                      <span class="badge" style="background-color: <%= @asset.tag.color %>;"><%= @asset.tag.name %></span>
                    <% end %>
                    <!-- Add more tags if provider has them -->
                  </div>
                  <div class="small text-muted mb-3">
                    <div><i class="fas fa-user me-2"></i> <%= provider.contact_name %></div>
                    <div><i class="fas fa-phone me-2"></i> <%= provider.phone %></div>
                    <div><i class="fas fa-envelope me-2"></i> <%= provider.email %></div>
                  </div>
                  <hr>
                  <div class="d-flex justify-content-end">
                     <!-- Could link to 'Select for Maintenance' if we were initiating from here, but this is just info -->
                     <%= link_to "Ver Ficha", provider_path(provider), class: "btn btn-sm btn-outline-primary" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="col-12">
            <div class="alert alert-warning border-0 shadow-sm">
              <i class="fas fa-exclamation-triangle me-2"></i>
              No hay proveedores registrados con la etiqueta <strong><%= @asset.tag.name %></strong>.
              <%= link_to "Registrar nuevo proveedor", new_provider_path, class: "alert-link" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>

<style>
  .nav-tabs .nav-link {
    color: #a0a0a0;
    border: none;
    border-bottom: 3px solid transparent;
    padding-bottom: 1rem;
  }
  .nav-tabs .nav-link.active {
    color: #ffffff; /* White text for active */
    border-bottom: 3px solid #ffffff; /* White border */
    background: transparent;
  }
  .nav-tabs .nav-link:hover {
    border-color: transparent;
    color: #ffffff;
  }
  .hover-card:hover {
    transform: translateY(-2px);
    transition: transform 0.2s;
  }
</style>
