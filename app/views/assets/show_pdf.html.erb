<div class="pdf-header">
  <div class="logo-text">MIM</div>
  <div class="report-title">
    Historial de Vida de Activo<br>
    <small style="font-size: 12px; color: #888;">Generado: <%= Date.today.strftime("%d/%m/%Y") %></small>
  </div>
</div>

<div class="row mb-4">
  <div class="col-6">
    <h3 class="mb-0"><%= @asset.name %></h3>
    <div class="text-muted"><%= @asset.make %> <%= @asset.model %> (<%= @asset.year %>)</div>
    <div class="mt-2">
      <strong>Patente:</strong> <%= @asset.plate.presence || "N/A" %><br>
      <strong>Serie:</strong> <%= @asset.serial_number.presence || "N/A" %><br>
      <strong>Ubicación:</strong> <%= @asset.location.presence || "N/A" %>
    </div>
  </div>
  <div class="col-6 text-end">
    <div class="card bg-light border-0">
      <div class="card-body py-2">
        <h5 class="mb-1">Estado Actual</h5>
        <span class="badge bg-<%= @asset.status == 'operativa' ? 'success' : 'warning' %> fs-6">
          <%= @asset.status.titleize %>
        </span>
        <div class="mt-2 small">
          <% @asset.meters.each do |meter| %>
            <div><strong><%= meter.name %>:</strong> <%= number_with_precision(meter.current_value, precision: 0) %> <%= meter.unit %></div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<h5 class="border-bottom pb-2 mb-3">Registro de Actividad (Bitácora)</h5>

<table class="table table-striped table-sm text-center">
  <thead class="table-dark">
    <tr>
      <th>Fecha</th>
      <th>Realizado Por</th>
      <th>Proveedor</th>
      <th>Detalle / Notas</th>
      <th class="text-end">Lectura</th>
    </tr>
  </thead>
  <tbody>
    <% if @logbook_records.any? %>
      <% @logbook_records.each do |record| %>
        <tr>
          <td><%= record.recorded_at.strftime("%d/%m/%Y") %></td>
          <td><%= record.user.name %></td>
          <td><%= record.provider&.name || "-" %></td>
          <td class="text-start"><%= record.notes.truncate(80) %></td>
          <td class="text-end">
             <!-- Show first meter change for brevity -->
             <% if record.logbook_entries.any? %>
               <%= number_with_precision(record.logbook_entries.first.current_value, precision: 0) %>
             <% else %>
               -
             <% end %>
          </td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="5" class="py-4 text-muted">Sin registros de actividad.</td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="pdf-footer">
  Mantenimiento Inteligente Maquinaria - Reporte Generado Automáticamente
</div>
