<div class="container" style="max-width: 800px;" data-controller="wizard">

  <div class="mb-4">
    <h3 class="mb-3" data-wizard-target="stepTitle">1. Seleccionar Categoría</h3>
    <div class="progress" style="height: 5px;">
      <div class="progress-bar bg-primary" role="progressbar" style="width: 0%" data-wizard-target="progressBar"></div>
    </div>
  </div>

  <%= form_with model: @maintenance_plan, local: true, class: "card shadow-sm border-0" do |f| %>
    <div class="card-body p-4">

      <!-- Hidden Fields for IDs -->
      <%= hidden_field_tag :component_id, nil, data: { wizard_target: "componentIdField" } %>
      <%= hidden_field_tag :sub_component_id, nil, data: { wizard_target: "subComponentIdField" } %>

      <!-- STEP 1: CATEGORY -->
      <div data-wizard-target="step1">
        <div class="mb-3">
          <label class="form-label fw-bold">¿A qué tipo de máquina aplica este plan?</label>
          <%= f.collection_select :asset_category_id, @asset_categories, :id, :name,
              { prompt: "-- Seleccionar Categoría --" },
              { class: "form-select form-select-lg", data: { wizard_target: "categorySelect" } } %>
          <div class="form-text mt-2">
            Seleccione la familia de activos (ej: Camiones, Generadores) donde se aplicará esta regla.
          </div>
        </div>
      </div>

      <!-- STEP 2: STRUCTURE -->
      <div data-wizard-target="step2" class="d-none">

        <!-- Component (System) -->
        <div class="mb-4">
          <label class="form-label fw-bold">Sistema / Grupo (Nivel 1)</label>

          <!-- Select Mode -->
          <div data-wizard-target="componentSelectWrapper">
            <select class="form-select" data-wizard-target="componentSelect" data-action="change->wizard#onComponentChange">
               <option>-- Seleccionar Sistema Primero --</option>
            </select>
          </div>

          <!-- Input Mode (New) -->
          <div data-wizard-target="componentInputWrapper" class="d-none">
             <div class="input-group">
               <%= text_field_tag :new_component_name, nil, class: "form-control", placeholder: "Nombre del Nuevo Sistema (ej: Sistema Hidráulico)", data: { wizard_target: "componentInput" } %>
               <button type="button" class="btn btn-outline-secondary" data-action="click->wizard#cancelNewComponent">Cancelar</button>
             </div>
             <div class="form-text text-primary">Se creará este nuevo sistema en la categoría seleccionada.</div>
          </div>
        </div>

        <!-- SubComponent (Part) -->
        <div class="mb-3">
          <label class="form-label fw-bold">Componente Específico (Nivel 2)</label>

          <!-- Select Mode -->
          <div data-wizard-target="subComponentSelectWrapper">
            <select class="form-select" data-wizard-target="subComponentSelect" data-action="change->wizard#onSubComponentChange">
               <option>-- Seleccionar Sistema Primero --</option>
            </select>
          </div>

          <!-- Input Mode (New) -->
          <div data-wizard-target="subComponentInputWrapper" class="d-none">
             <div class="input-group">
               <%= text_field_tag :new_sub_component_name, nil, class: "form-control", placeholder: "Nombre del Componente (ej: Manguera Principal)", data: { wizard_target: "subComponentInput" } %>
               <button type="button" class="btn btn-outline-secondary" data-action="click->wizard#cancelNewSubComponent">Cancelar</button>
             </div>
             <div class="form-text text-primary">Se creará este componente bajo el sistema seleccionado.</div>
          </div>
        </div>

      </div>

      <!-- STEP 3: RULE DEFINITION -->
      <div data-wizard-target="step3" class="d-none">
        <div class="mb-3">
          <label class="form-label fw-bold">Nombre del Plan</label>
          <%= f.text_field :name, class: "form-control", placeholder: "Ej: Cambio de Aceite 5000h" %>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Frecuencia</label>
            <%= f.number_field :frequency, class: "form-control", placeholder: "500" %>
          </div>
          <div class="col-md-6 mb-3">
             <label class="form-label">Unidad</label>
             <%= f.select :unit, ["Horas", "Kilómetros", "Días", "Semanas", "Meses", "Años"], {}, { class: "form-select" } %>
          </div>
        </div>

        <div class="mb-3">
           <label class="form-label">Instrucciones / Detalles</label>
           <%= f.text_area :details, rows: 4, class: "form-control", placeholder: "Describa el procedimiento a realizar..." %>
        </div>
      </div>

    </div>

    <!-- FOOTER ACTIONS -->
    <div class="card-footer bg-white p-3 d-flex justify-content-between">
       <button type="button" class="btn btn-secondary" data-action="wizard#previous">Atrás</button>

       <!-- Renamed targets to avoid conflict with content divs -->
       <button type="button" class="btn btn-primary" data-action="wizard#next" data-wizard-target="buttonStep1">Siguiente <i class="fas fa-arrow-right ms-2"></i></button>
       <button type="button" class="btn btn-primary d-none" data-action="wizard#next" data-wizard-target="buttonStep2">Siguiente <i class="fas fa-arrow-right ms-2"></i></button>

       <%= f.submit "Guardar Plan", class: "btn btn-success d-none", data: { wizard_target: "submitButton" } %>
    </div>
  <% end %>

</div>
