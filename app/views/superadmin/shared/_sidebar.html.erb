      <nav class="sidebar">
        <!-- User Info (Top Left) -->
        <div class="user-profile">
          <div class="user-name"><%= current_super_admin.email %></div>
          <div class="user-role">Super Admin (Global)</div>
        </div>

        <!-- Logo -->
        <div class="sidebar-logo">
          <%= image_tag "logo.png", alt: "MIM Logo" %>
          <div class="logo-text">BÓVEDA SAAS</div>
        </div>

        <!-- Navigation -->
        <div class="nav-menu">
          <%= link_to superadmin_dashboard_index_path, class: "nav-link #{'active' if current_page?(superadmin_dashboard_index_path)}" do %>
            <i class="fas fa-home icon-dashboard"></i> Dashboard
          <% end %>

          <%= link_to superadmin_accounts_path, class: "nav-link #{'active' if controller_name == 'accounts'}" do %>
            <i class="fas fa-building icon-assets"></i> Empresas (Cuentas)
          <% end %>

          <%= link_to superadmin_super_admins_path, class: "nav-link #{'active' if controller_name == 'super_admins'}" do %>
            <i class="fas fa-users-cog icon-providers"></i> Super Usuarios
          <% end %>

          <%= link_to superadmin_invoices_path, class: "nav-link #{'active' if controller_name == 'invoices'}" do %>
            <i class="fas fa-file-invoice-dollar icon-logbook"></i> Facturas SaaS
          <% end %>

          <%= link_to superadmin_settlements_path, class: "nav-link #{'active' if controller_name == 'settlements'}" do %>
            <i class="fas fa-money-check-alt text-warning"></i> Liquidaciones Flow
          <% end %>

          <!-- Configuration Dropdown/Link -->
          <a class="nav-link" data-bs-toggle="collapse" href="#configMenu" role="button" aria-expanded="<%= request.path.match?(/regions|cities|system_settings/) %>" aria-controls="configMenu">
             <i class="fas fa-cog icon-config"></i> Ajustes Globales
          </a>
          <div class="collapse <%= 'show' if request.path.match?(/regions|cities|system_settings/) %>" id="configMenu">
             <div class="ps-4">
                 <%= link_to "Regiones Base", superadmin_regions_path, class: "nav-link small py-1 #{'active' if current_page?(superadmin_regions_path)}" %>
                 <%= link_to "Ciudades Base", superadmin_cities_path, class: "nav-link small py-1 #{'active' if current_page?(superadmin_cities_path)}" %>
                 <%= link_to "Server & API", superadmin_system_settings_path, class: "nav-link small py-1 #{'active' if current_page?(superadmin_system_settings_path)}" %>
             </div>
          </div>
        </div>

        <!-- Footer Buttons -->
        <div class="sidebar-footer">
           <%= button_to "Cerrar Sesion", destroy_super_admin_session_path, method: :delete, class: "btn-sidebar-action" %>
        </div>
      </nav>
