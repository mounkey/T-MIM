<%= turbo_frame_tag "modal_body" do %>
  <h2 class="text-center mb-4 text-secondary"><i class="fas fa-user-shield text-primary"></i> <%= @super_admin.new_record? ? "Nuevo Súper Usuario" : "Editar Súper Usuario" %></h2>

  <%= form_with(model: [:superadmin, @super_admin], data: { turbo_frame: "_top" }) do |form| %>
    <% if @super_admin.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@super_admin.errors.count, 'error') %> impidieron guardar:</h4>
        <ul class="mb-0">
          <% @super_admin.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-12 mb-3">
        <%= form.label :nombre, "Nombre Completo", class: "form-label fw-bold" %>
        <%= form.text_field :nombre, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :email, "Correo Electrónico (Login)", class: "form-label fw-bold" %>
        <%= form.email_field :email, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :telefono, "Teléfono", class: "form-label fw-bold" %>
        <%= form.text_field :telefono, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :region_id, "Región", class: "form-label fw-bold" %>
        <%= form.collection_select :region_id, Region.order(:name), :id, :name, { prompt: 'Seleccionar...' }, class: "form-select" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :city_id, "Ciudad", class: "form-label fw-bold" %>
        <%= form.collection_select :city_id, City.order(:name), :id, :name, { prompt: 'Seleccionar...' }, class: "form-select" %>
      </div>
    </div>

    <h5 class="border-bottom pb-2 mt-3 mb-3 text-danger">Seguridad</h5>
    
    <div class="row">
      <div class="col-md-6 mb-3">
        <%= form.label :password, "Contraseña", class: "form-label fw-bold" %>
        <%= form.password_field :password, class: "form-control", placeholder: (@super_admin.persisted? ? "Dejar en blanco para no cambiar" : "") %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :password_confirmation, "Confirmar Contraseña", class: "form-label fw-bold" %>
        <%= form.password_field :password_confirmation, class: "form-control" %>
      </div>
    </div>

    <div class="mt-4 text-center">
      <%= form.submit "Guardar Súper Usuario", class: "btn btn-primary px-5 rounded-pill" %>
    </div>
  <% end %>
<% end %>
