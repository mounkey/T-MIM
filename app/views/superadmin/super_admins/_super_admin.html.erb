<div id="<%= dom_id super_admin %>" class="p-3">

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Email:</span><br>
    <%= super_admin.email %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Reset Password Sent At:</span><br>
    <%= super_admin.reset_password_sent_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Remember Created At:</span><br>
    <%= super_admin.remember_created_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Created At:</span><br>
    <%= super_admin.created_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Updated At:</span><br>
    <%= super_admin.updated_at %>
  </div>
</div>
