<div id="<%= dom_id account %>" class="p-3">

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Name:</span><br>
    <%= account.name %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Subdomain:</span><br>
    <%= account.subdomain %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Active:</span><br>
    <%= account.active %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Created At:</span><br>
    <%= account.created_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Updated At:</span><br>
    <%= account.updated_at %>
  </div>
</div>
