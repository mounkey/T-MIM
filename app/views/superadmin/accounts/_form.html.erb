<%= turbo_frame_tag "modal_body" do %>
  <h2 class="text-center mb-4 text-secondary"><i class="fas fa-building text-primary"></i> <%= @account.new_record? ? "Nueva Empresa" : "Editar Empresa" %></h2>

  <%= form_with(model: [:superadmin, @account], data: { turbo_frame: "_top" }) do |form| %>
    <% if @account.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@account.errors.count, 'error') %> impidieron guardar este registro:</h4>
        <ul class="mb-0">
          <% @account.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <h5 class="border-bottom pb-2 mb-3 text-primary">Información Comercial</h5>
    
    <div class="row">
      <div class="col-md-12 mb-3">
        <%= form.label :name, "Nombre Corto (Para el sistema)", class: "form-label fw-bold" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>
      
      <div class="col-md-12 mb-3">
        <%= form.label :razon_social, "Razón Social", class: "form-label fw-bold" %>
        <%= form.text_field :razon_social, class: "form-control" %>
      </div>

      <div class="col-md-12 mb-3">
        <%= form.label :nombre_fantasia, "Nombre de Fantasía", class: "form-label fw-bold" %>
        <%= form.text_field :nombre_fantasia, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :rut, "RUT Empresa", class: "form-label fw-bold" %>
        <%= form.text_field :rut, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :email, "Email Comercial", class: "form-label fw-bold" %>
        <%= form.email_field :email, class: "form-control" %>
      </div>

      <div class="col-md-12 mb-3">
        <%= form.label :direccion, "Dirección Completa", class: "form-label fw-bold" %>
        <%= form.text_field :direccion, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :region_id, "Región", class: "form-label fw-bold" %>
        <%= form.collection_select :region_id, Region.order(:name), :id, :name, { prompt: 'Seleccionar...' }, class: "form-select" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :city_id, "Ciudad", class: "form-label fw-bold" %>
        <%= form.collection_select :city_id, City.order(:name), :id, :name, { prompt: 'Seleccionar...' }, class: "form-select" %>
      </div>
    </div>

    <h5 class="border-bottom pb-2 mt-3 mb-3 text-primary">Contacto Administrativo</h5>

    <div class="row">
      <div class="col-md-12 mb-3">
        <%= form.label :contacto_nombre, "Nombre Completo del Contacto", class: "form-label fw-bold" %>
        <%= form.text_field :contacto_nombre, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :contacto_rut, "RUT Contacto", class: "form-label fw-bold" %>
        <%= form.text_field :contacto_rut, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :contacto_cargo, "Cargo", class: "form-label fw-bold" %>
        <%= form.text_field :contacto_cargo, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :contacto_email, "Email Contacto", class: "form-label fw-bold" %>
        <%= form.email_field :contacto_email, class: "form-control" %>
      </div>

      <div class="col-md-6 mb-3">
        <%= form.label :contacto_telefono, "Teléfono", class: "form-label fw-bold" %>
        <%= form.text_field :contacto_telefono, class: "form-control" %>
      </div>
    </div>

    <h5 class="border-bottom pb-2 mt-3 mb-3 text-danger">Configuración del Sistema</h5>
    
    <div class="row align-items-center">
      <div class="col-md-6 mb-3">
        <%= form.label :subdomain, "Subdominio (SaaS)", class: "form-label fw-bold text-danger" %>
        <div class="input-group">
          <%= form.text_field :subdomain, class: "form-control" %>
          <span class="input-group-text">.mim.cl</span>
        </div>
      </div>

      <div class="col-md-6 mb-3 mt-4">
        <div class="form-check form-switch fs-5">
          <%= form.check_box :active, class: "form-check-input" %>
          <%= form.label :active, "Cuenta Activa (Acceso Permitido)", class: "form-check-label fw-bold" %>
        </div>
      </div>
    </div>

    <div class="mt-4 text-center">
      <%= form.submit "Guardar Expediente", class: "btn btn-primary px-5 rounded-pill" %>
    </div>
  <% end %>
<% end %>
