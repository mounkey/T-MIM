<% content_for :page_title, "Bóveda Global SaaS" %>

<div class="row">
  <div class="col-md-12">
    <div class="card bg-white p-4 rounded shadow-sm border-0">
      <h3 class="mb-4 text-secondary"><i class="fas fa-shield-alt text-primary"></i> Bienvenido, <%= current_super_admin.email %></h3>
      <p class="text-muted">Estás dentro de la Bóveda del Sistema. Desde aquí tienes control absoluto (Multitenant apagado) sobre todas las empresas, finanzas y configuraciones de servidor.</p>
      
      <div class="row mt-4 g-3">
        <div class="col-md-3">
          <div class="border rounded p-3 text-center bg-light">
            <h2 class="text-primary fw-bold mb-0"><%= Account.count %></h2>
            <p class="text-muted mb-0 small">Empresas Activas</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="border rounded p-3 text-center bg-light">
            <h2 class="text-primary fw-bold mb-0">
              <%= Account.where(active: true).sum(:monthly_price_uf).round(2) %> UF
            </h2>
            <p class="text-muted mb-0 small">MRR Proyectado Mensual</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="border rounded p-3 text-center bg-light">
            <h2 class="text-success fw-bold mb-0">$<%= number_with_delimiter(Payment.where(payment_channel: :flow_online).sum(:amount).to_i) %></h2>
            <p class="text-muted mb-0 small">Recaudación Flow</p>
          </div>
        </div>
        <div class="col-md-3">
          <div class="border rounded p-3 text-center bg-light">
            <h2 class="text-info fw-bold mb-0">$<%= number_with_delimiter(Payment.where(payment_channel: :flow_online).sum(:platform_fee).to_i) %></h2>
            <p class="text-muted mb-0 small">Ganancias T-MIM</p>
          </div>
        </div>
      </div>

      <!-- Resumen por Planes de Suscripción -->
      <h5 class="mt-4 pt-3 border-top text-secondary"><i class="fas fa-layer-group text-primary me-2"></i> Distribución de Talleres por Plan</h5>
      <div class="row g-3 mt-1">
        <% Account::PLANS.each do |key, plan| %>
          <% count = Account.where(plan_type: key).count %>
          <div class="col-md">
            <div class="card border p-3 text-center h-100 shadow-sm">
              <span class="badge bg-dark mb-2 mx-auto"><%= plan[:name] %></span>
              <h3 class="fw-bold mb-0 text-dark"><%= count %></h3>
              <small class="text-muted"><%= plan[:price_uf] %> UF / mes</small>
              <div class="mt-2 small text-primary fw-bold">
                <%= (count * plan[:price_uf]).round(2) %> UF mes
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
