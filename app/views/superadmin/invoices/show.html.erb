<%= turbo_frame_tag "modal_body" do %>

<div class="card bg-white rounded shadow-sm border-0 mb-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h4 class="mb-0 text-secondary">Detalles: Invoices</h4>
    <div>
      <%= link_to "Editar", [:edit, :superadmin, @invoice], class: "btn btn-outline-primary btn-sm me-2" %>
      <%= link_to "Volver", [:superadmin, :invoices], class: "btn btn-outline-secondary btn-sm", data: { turbo_frame: "_top" } %>
    </div>
  </div>
  <div class="card-body">
    <%= render @invoice %>
  </div>
</div>

<% end %>