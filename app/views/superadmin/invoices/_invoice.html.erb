<div id="<%= dom_id invoice %>" class="p-3">

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Account:</span><br>
    <%= invoice.account_id %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Amount:</span><br>
    <%= invoice.amount %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Status:</span><br>
    <%= invoice.status %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Due Date:</span><br>
    <%= invoice.due_date %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Paid At:</span><br>
    <%= invoice.paid_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Created At:</span><br>
    <%= invoice.created_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Updated At:</span><br>
    <%= invoice.updated_at %>
  </div>
</div>
