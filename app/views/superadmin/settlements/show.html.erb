<div class="row justify-content-center">
  <div class="col-md-9">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <%= link_to superadmin_settlements_path, class: "btn btn-outline-light" do %>
        <i class="fas fa-arrow-left me-1"></i> Volver a Liquidaciones
      <% end %>
      <div>
        <span class="badge <%= @settlement.status_badge[:class] %> fs-6">
          <%= @settlement.status_badge[:label] %>
        </span>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white border-0 py-3">
        <h4 class="mb-0 fw-bold text-dark">Liquidación Quincenal: <%= @settlement.folio %></h4>
        <small class="text-muted">Período: <%= @settlement.period_start.strftime("%d/%m/%Y") %> al <%= @settlement.period_end.strftime("%d/%m/%Y") %></small>
      </div>
      <div class="card-body p-4">
        
        <!-- Info Cards -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="p-3 bg-light rounded">
              <h6 class="fw-bold text-dark text-uppercase small mb-2">Datos del Taller y Cuenta Bancaria</h6>
              <div><strong>Empresa:</strong> <%= @settlement.account.name %></div>
              <div class="mt-2 text-muted small"><%= @settlement.bank_details_snapshot %></div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 bg-light rounded">
              <h6 class="fw-bold text-dark text-uppercase small mb-2">Resumen Financiero del Corte</h6>
              <div class="d-flex justify-content-between"><span>Bruto Recaudado Flow:</span> <strong>$<%= number_with_delimiter(@settlement.total_collected.to_i) %></strong></div>
              <div class="d-flex justify-content-between text-muted"><span>Costo Pasarela Flow:</span> <strong>-$<%= number_with_delimiter(@settlement.total_gateway_fees.to_i) %></strong></div>
              <div class="d-flex justify-content-between text-success"><span>Comisión T-MIM (Ganancia):</span> <strong>-$<%= number_with_delimiter(@settlement.total_platform_fees.to_i) %></strong></div>
              <hr class="my-2">
              <div class="d-flex justify-content-between fs-5 fw-bold text-primary"><span>Monto Líquido a Transferir:</span> <span>$<%= number_with_delimiter(@settlement.net_payout.to_i) %></span></div>
            </div>
          </div>
        </div>

        <!-- Transfer Confirmation Form -->
        <% if @settlement.pending? %>
          <div class="card border-warning p-4 bg-light mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-check-circle text-warning me-1"></i> Confirmar y Registrar Transferencia Bancaria</h5>
            <%= form_with url: mark_as_paid_superadmin_settlement_path(@settlement), method: :patch, local: true do |f| %>
              <div class="row g-3">
                <div class="col-md-8">
                  <label class="form-label fw-bold">N° de Comprobante / Código de Transferencia Bancaria</label>
                  <%= text_field_tag :transfer_reference, nil, class: "form-control", placeholder: "Ej: TRF-BancoChile-982341", required: true %>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                  <%= f.submit "Marcar como Transferida", class: "btn btn-success w-100 fw-bold" %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="alert alert-success d-flex align-items-center mb-4">
            <i class="fas fa-check-double fa-2x me-3"></i>
            <div>
              <h6 class="fw-bold mb-0">Transferencia Realizada y Liquidada</h6>
              <small>Transferido el <%= @settlement.transferred_at&.strftime("%d/%m/%Y %H:%M") %> | Comprobante: <strong><%= @settlement.transfer_reference.presence || 'S/Ref' %></strong></small>
            </div>
          </div>
        <% end %>

        <!-- Detalle de Transacciones Flow del Corte -->
        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-list text-primary me-2"></i> Transacciones Flow Incluidas en este Corte</h5>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Fecha</th>
                <th>OT / Folio</th>
                <th>Vehículo</th>
                <th class="text-end">Monto Bruto</th>
                <th class="text-end">Comisión Retenida</th>
                <th class="text-end">Monto Neto</th>
              </tr>
            </thead>
            <tbody>
              <% if @payments.any? %>
                <% @payments.each do |p| %>
                  <tr>
                    <td class="small"><%= p.recorded_at.strftime("%d/%m/%Y %H:%M") %></td>
                    <td class="fw-bold text-primary"><%= p.payment_order&.folio_number || "-" %></td>
                    <td><%= p.payment_order&.asset&.plate %> - <%= p.payment_order&.asset&.name %></td>
                    <td class="text-end fw-semibold text-dark">$<%= number_with_delimiter(p.amount.to_i) %></td>
                    <td class="text-end text-danger">-$<%= number_with_delimiter((p.flow_fee + p.platform_fee).to_i) %></td>
                    <td class="text-end fw-bold text-success">$<%= number_with_delimiter(p.net_amount.to_i) %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="6" class="text-center py-3 text-muted">No hay pagos vinculados.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>
