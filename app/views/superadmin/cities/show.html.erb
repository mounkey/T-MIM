
<div class="card bg-white rounded shadow-sm border-0 mb-4">
  <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
    <h4 class="mb-0 text-secondary">Detalles: Cities</h4>
    <div>
      <%= link_to "Editar", [:edit, :superadmin, @city], class: "btn btn-outline-primary btn-sm me-2" %>
      <%= link_to "Volver", [:superadmin, :cities], class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>
  <div class="card-body">
    <%= render @city %>
  </div>
</div>
