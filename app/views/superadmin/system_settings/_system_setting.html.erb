<div id="<%= dom_id system_setting %>" class="p-3">

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Key:</span><br>
    <%= system_setting.key %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Value:</span><br>
    <%= system_setting.value %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Description:</span><br>
    <%= system_setting.description %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Created At:</span><br>
    <%= system_setting.created_at %>
  </div>

  <div class="mb-3 border-bottom pb-2">
    <span class="fw-bold text-secondary">Updated At:</span><br>
    <%= system_setting.updated_at %>
  </div>
</div>
