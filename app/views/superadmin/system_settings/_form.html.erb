<%= turbo_frame_tag "modal_body" do %>
  <h2 class="text-center mb-4 text-secondary"><i class="fas fa-cog text-primary"></i> <%= @system_setting.new_record? ? "Nuevo Ajuste Global" : "Editar Ajuste Global" %></h2>

  <%= form_with(model: [:superadmin, @system_setting], data: { turbo_frame: "_top" }) do |form| %>
    <% if @system_setting.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@system_setting.errors.count, 'error') %> impidieron guardar:</h4>
        <ul class="mb-0">
          <% @system_setting.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row">
      <div class="col-md-12 mb-3">
        <%= form.label :key, "Clave (Ej: UF_VALOR, SMTP_PASSWORD)", class: "form-label fw-bold" %>
        <%= form.text_field :key, class: "form-control text-monospace", placeholder: "NOMBRE_DE_LA_CLAVE" %>
      </div>

      <div class="col-md-12 mb-3">
        <%= form.label :value, "Valor", class: "form-label fw-bold" %>
        <%= form.text_area :value, class: "form-control", rows: 3 %>
      </div>

      <div class="col-md-12 mb-3">
        <%= form.label :description, "Descripción (Uso del ajuste)", class: "form-label fw-bold" %>
        <%= form.text_field :description, class: "form-control" %>
      </div>
    </div>

    <div class="mt-4 text-center">
      <%= form.submit "Guardar Ajuste", class: "btn btn-primary px-5 rounded-pill" %>
    </div>
  <% end %>
<% end %>
